---
/**
 * Kleine inline-SVG iconenset. Stroke volgt currentColor.
 * Gebruik: <Icon name="arrow" />
 */
interface Props {
  name:
    | 'arrow'
    | 'login'
    | 'plus'
    | 'check'
    | 'clock'
    | 'circle'
    | 'phone'
    | 'building';
  size?: number;
  class?: string;
}
const { name, size = 16, class: cls } = Astro.props;
const paths: Record<Props['name'], string> = {
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  login:
    '<path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  check: '<path d="M5 13l4 4L19 7"/>',
  clock: '<path d="M12 8v4l3 3M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/>',
  circle: '<circle cx="12" cy="12" r="4"/>',
  phone:
    '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>',
  building: '<path d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-3"/>',
};
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  width={size}
  height={size}
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={cls}
  set:html={paths[name]}
/>
