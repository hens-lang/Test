---
/**
 * Duotone-fotoblok (blauw/zwart getint) met grain en blauwe hoekbrackets.
 * Toont een premium-donker gradient-vlak zolang het fotobestand ontbreekt.
 * `plain` = normale foto zonder duotone; `blur` = portaal-screenshots.
 */
interface Props {
  src: string;
  alt?: string;
  ratio?: string;
  caption?: string;
  brackets?: boolean;
  plain?: boolean;
  blur?: boolean;
  position?: string;
  class?: string;
}
const {
  src,
  alt = '',
  ratio = '4 / 5',
  caption,
  brackets = true,
  plain = false,
  blur = false,
  position = 'center',
  class: cls,
} = Astro.props;
---

<figure
  class:list={['duo', cls, { plain, blur }]}
  style={`aspect-ratio:${ratio}`}
>
  <img src={src} alt={alt} loading="lazy" decoding="async" style={`object-position:${position}`} onerror="this.remove()" />
  {brackets && <><span class="bracket tl"></span><span class="bracket br"></span></>}
  {caption && <figcaption class="duo-cap">{caption}</figcaption>}
</figure>
