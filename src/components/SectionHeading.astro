---
/**
 * Kop links, lede rechts — het standaard sectiekopje.
 * De `it`-woorden en de punt worden als HTML meegegeven via slots/props.
 */
interface Props {
  eyebrow?: string;
  lede?: string;
  class?: string;
}
const { eyebrow, lede, class: cls } = Astro.props;
---

<div class:list={['section-head reveal', cls]}>
  <div>
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h2><slot /></h2>
  </div>
  {
    lede && (
      <p class="lede" set:html={lede} />
    )
  }
</div>
