---
/**
 * Sectietype A — STATEMENT (het rustpunt).
 * Volle breedte, alleen typografie, veel lucht. Eén per pagina.
 */
interface Props {
  eyebrow?: string;
  center?: boolean;
  dark?: boolean;
  class?: string;
}
const { eyebrow, center = false, dark = false, class: cls } = Astro.props;
---

<section class:list={['statement reveal', cls, { center, dark }]}>
  <div class="statement-inner">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h2><slot /></h2>
    <slot name="body" />
  </div>
</section>

<style>
  .statement.dark {
    background: var(--ink);
    color: var(--dark-text);
  }
  .statement.dark :global(.eyebrow) {
    color: var(--dark-mute);
  }
  .statement.dark h2 {
    color: var(--paper);
  }
  .statement :global(.sub) {
    margin: clamp(20px, 2.5vw, 32px) 0 0;
    font-size: var(--t-lede);
    color: var(--ink-soft);
    line-height: 1.45;
    max-width: 46ch;
  }
  .statement.center :global(.sub) {
    margin-inline: auto;
  }
  .statement.dark :global(.sub) {
    color: var(--dark-text);
  }
</style>
