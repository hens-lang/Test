---
import { nav, site } from '@/lib/site';

const current = '/' + (Astro.url.pathname.replace(/^\/|\/$/g, '') || '');
function isActive(href: string) {
  if (href === '/') return current === '/';
  return current === href || current.startsWith(href + '/');
}
---

<header class="site-nav" data-nav>
  <a href="/" class="brand" aria-label="LINK.">LINK<span class="d">.</span></a>
  <nav class="site-links" aria-label="Hoofdmenu">
    {
      nav
        .filter((i) => i.href !== '/')
        .map((item) => (
          <a href={item.href} class:list={{ active: isActive(item.href) }}>
            {item.label}
          </a>
        ))
    }
  </nav>
  <div class="site-right">
    <a href={site.portal.url} class="site-login" target="_blank" rel="noopener">Inloggen</a>
    <a href="/contact" class="site-cta" data-magnetic>Even kennismaken <span class="arw">→</span></a>
  </div>
</header>
