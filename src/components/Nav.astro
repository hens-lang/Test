---
import { nav, site } from '@/lib/site';

const current = '/' + (Astro.url.pathname.replace(/^\/|\/$/g, '') || '');
function isActive(href: string) {
  if (href === '/') return current === '/';
  return current === href || current.startsWith(href + '/');
}
---

<!-- Dossier-metabar -->
<div class="metabar">
  <span>LINK<span class="b">.</span> — B2B ACQUISITIE</span>
  <span class="hide-s">ALPHEN A/D RIJN</span>
  <span class="hide-s">EST. MMXXV</span>
  <span>MAANDELIJKS OPZEGBAAR</span>
</div>

<header class="enav" data-nav>
  <a href="/" class="logo" aria-label="LINK.">LINK<span class="b">.</span></a>
  <nav class="enav-links" aria-label="Hoofdmenu">
    {
      nav
        .filter((i) => i.href !== '/')
        .map((item) => (
          <a href={item.href} class:list={{ active: isActive(item.href) }}>
            {item.label}
          </a>
        ))
    }
  </nav>
  <div class="enav-right">
    <a href={site.portal.url} class="enav-login hide-s" target="_blank" rel="noopener">Inloggen</a>
    <a href="/contact" class="enav-cta">Even kennismaken <span class="arw">→</span></a>
  </div>
</header>
