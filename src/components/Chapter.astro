---
/**
 * Hoofdstuklabel dat met een node op de verbindingslijn hangt.
 * bv. <Chapter n="02" label="Wat we doen" />
 */
interface Props {
  n: string;
  label: string;
  id?: string;
}
const { n, label, id } = Astro.props;
---

<span class="chapter" id={id} data-chapter={n}>
  <i class="node"></i>{n} — {label}
</span>
