---
/**
 * Sectietype B — SPLIT (het werkpaard).
 * Foto de ene kant, tekst de andere. `reverse` spiegelt de compositie.
 */
import Figure from './Figure.astro';
interface Props {
  src: string;
  alt: string;
  ratio?: string;
  tag?: string;
  live?: boolean;
  blur?: boolean;
  position?: string;
  reverse?: boolean;
  dark?: boolean;
  class?: string;
}
const {
  src,
  alt,
  ratio = '4 / 3',
  tag,
  live = false,
  blur = false,
  position = 'center',
  reverse = false,
  dark = false,
  class: cls,
} = Astro.props;
---

<section class:list={['split reveal', cls, { reverse, dark }]}>
  <div class="split-media">
    <Figure {src} {alt} {ratio} {tag} {live} {blur} {position} radius="var(--r-card)" />
  </div>
  <div class="split-body">
    <slot />
  </div>
</section>

<style>
  .split {
    padding: clamp(48px, 6vw, 96px) var(--pad-x);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 5vw, 80px);
    align-items: center;
  }
  .split.dark {
    background: var(--ink);
    color: var(--dark-text);
  }
  .split.reverse .split-media {
    order: 2;
  }
  .split-body {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .split-body :global(h2) {
    font-size: var(--t-h1);
    line-height: 0.98;
    letter-spacing: -0.04em;
    font-weight: 800;
    margin: 8px 0 0;
    max-width: 14ch;
  }
  .split.dark .split-body :global(h2) {
    color: var(--paper);
  }
  .split-body :global(p) {
    color: var(--ink-soft);
    font-size: 17px;
    line-height: 1.6;
    max-width: 46ch;
    margin: 0;
  }
  .split.dark .split-body :global(p) {
    color: var(--dark-text);
  }
  @media (max-width: 980px) {
    .split,
    .split.reverse {
      grid-template-columns: 1fr;
    }
    .split.reverse .split-media {
      order: 0;
    }
  }
</style>
