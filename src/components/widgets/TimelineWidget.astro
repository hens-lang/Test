---
/**
 * Verhaal-hero — tijdlijn. Statisch, met "nu"-markering op de laatste stap.
 */
const events = [
  { date: 'Einde zomer 2025', title: 'Een gesprek dat <em>bleef hangen</em>', sub: 'Na jaren in direct sales blijft één vraag hangen: waarom draait het in dit vak zo vaak om aantallen in plaats van resultaat?' },
  { date: 'Najaar 2025', title: 'LINK<span class="punc">.</span> wordt opgericht', sub: 'De eerste samenwerking ontstond via een kennis. Geen website, geen poespas, gewoon doen wat ik beloofde.' },
  { date: 'Winter 2025', title: 'Eerste <em>structurele</em> partners', sub: 'De eerste B2B-bedrijven werken op maandelijkse basis met LINK. Geen lange contracten, wel langlopend vertrouwen.' },
  { date: 'Voorjaar 2026', title: 'Verfijning van onze aanpak', sub: 'De 7-stappen methode krijgt vorm. Doelgroep-bepaling vóór actie wordt het uitgangspunt.' },
  { date: 'Vandaag', title: 'Groeiende groep <em>partners</em>, één belofte', sub: 'Persoonlijk aan tafel bij de juiste mensen, voor B2B-bedrijven door heel Nederland.', now: true },
];
---

<aside class="timeline reveal" aria-label="Tijdlijn LINK.">
  <div class="tl-head">
    <div class="tl-title">
      <span class="tl-eyebrow">Onze tijdlijn</span>
      <span class="tl-name">Hoe het begon<span class="punc">.</span></span>
    </div>
    <span class="tl-badge"><span class="live-dot"></span> Nu</span>
  </div>

  <ul class="tl-list">
    {
      events.map((e) => (
        <li class:list={['tl-event', { now: e.now }]}>
          <span class="tl-date">{e.date}</span>
          <span class="tl-title-row" set:html={e.title} />
          <span class="tl-sub">{e.sub}</span>
        </li>
      ))
    }
  </ul>

  <div class="tl-foot">
    <div class="tl-stat">
      <span class="tl-stat-num">1<em>gezicht</em></span>
      <span class="tl-stat-lbl">dat het werk<br />zelf doet</span>
    </div>
    <div class="tl-divider"></div>
    <div class="tl-stat">
      <span class="tl-stat-num">0<em>contracten</em></span>
      <span class="tl-stat-lbl">vaste binding,<br />maandelijks opzegbaar</span>
    </div>
  </div>
</aside>

<style>
  .timeline {
    background: var(--paper);
    border: 1px solid var(--line-soft);
    border-radius: var(--r-card);
    padding: 24px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .tl-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .tl-title {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tl-eyebrow {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mute);
    font-weight: 500;
  }
  .tl-name {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--ink);
  }
  .tl-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--ink);
    color: var(--paper);
    padding: 5px 10px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .live-dot {
    width: 6px;
    height: 6px;
    background: var(--blue);
    border-radius: 50%;
    animation: live-pulse 1.6s ease-out infinite;
  }
  .tl-list {
    list-style: none;
    margin: 0;
    padding: 0 0 0 22px;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .tl-list::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: linear-gradient(to bottom, var(--line) 0%, var(--line) 70%, transparent 100%);
  }
  .tl-event {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .tl-event::before {
    content: '';
    position: absolute;
    left: -22px;
    top: 4px;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--ink);
    box-sizing: border-box;
    z-index: 2;
  }
  .tl-event.now::before {
    background: var(--blue);
    border-color: var(--blue);
    animation: tl-now-pulse 2.4s ease-out infinite;
  }
  .tl-date {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mute);
    font-weight: 700;
  }
  .tl-event.now .tl-date {
    color: var(--blue);
  }
  .tl-title-row {
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .tl-title-row :global(em) {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--blue);
    font-weight: 400;
  }
  .tl-title-row :global(.punc) {
    color: var(--blue);
  }
  .tl-sub {
    font-size: 12px;
    color: var(--mute);
    line-height: 1.45;
    max-width: 38ch;
  }
  .tl-foot {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--line-soft);
  }
  .tl-stat {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tl-stat-num {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--ink);
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
  }
  .tl-stat-num em {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--blue);
    font-size: 18px;
    font-weight: 400;
  }
  .tl-stat-lbl {
    font-size: 11px;
    color: var(--mute);
    line-height: 1.35;
  }
  .tl-divider {
    width: 1px;
    height: 36px;
    background: var(--line);
  }
  @keyframes live-pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.6;
      transform: scale(1.2);
    }
  }
  @keyframes tl-now-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(41, 176, 242, 0.6);
    }
    50% {
      box-shadow: 0 0 0 8px rgba(41, 176, 242, 0);
    }
  }
</style>
