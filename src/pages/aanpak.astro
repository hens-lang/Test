---
import Base from '@/layouts/Base.astro';
import Figure from '@/components/Figure.astro';
import PipelineWidget from '@/components/widgets/PipelineWidget.astro';

const steps = [
  { n: '01', t: 'We verdiepen ons in jouw <span class="serif">bedrijf</span>', p: 'Wat verkoop je, wat onderscheidt je, en wie zit er nu al aan tafel? <strong>Geen oppervlakkige briefing.</strong>' },
  { n: '02', t: 'We bepalen samen het <span class="serif">groeidoel</span>', p: 'Hoeveel afspraken? Welke omzet? Tegen welk tempo? Eerst helder, dan pas in actie.' },
  { n: '03', t: 'We bepalen samen een <span class="serif">doelgroep</span>', p: 'Hier nemen we ruim de tijd voor. We sturen bij tot het <strong>ideale klantprofiel</strong> klopt.' },
  { n: '04', t: 'We stellen een <span class="serif">prospectlijst</span> samen', p: 'Geen gekochte database. Een handgemaakte lijst met bedrijven waar jij echt aan tafel wilt komen.' },
  { n: '05', t: 'De juiste beslisser bereiken', p: 'Een goed voorbereide aanpak die past bij jouw bedrijf en verhaal. De juiste persoon, op de juiste manier.' },
  { n: '06', t: 'Interesse polsen en <span class="serif">kwalificeren</span>', p: 'We brengen alleen door wat écht een gesprek waard is. <strong>Kwaliteit boven volume.</strong>' },
  { n: '07', t: 'De afspraak inplannen', p: 'Jij voert het gesprek en sluit de deal. Wij blijven beschikbaar om mee te denken en bij te sturen.' },
];
---

<Base
  title="Onze aanpak in 7 stappen | LINK. B2B acquisitie"
  description="Van doelgroep bepalen tot de afspraak in jouw agenda: ontdek hoe LINK. in zeven heldere stappen werkt aan kwalitatieve B2B-afspraken die ertoe doen."
  path="/aanpak"
>
  <!-- Hero -->
  <section class="section pair hero">
    <div class="hero-copy reveal">
      <span class="eyebrow">Onze aanpak</span>
      <h1 class="display">Eerst begrijpen wie je <span class="serif">ideale</span> klant is<span class="d">.</span></h1>
      <p class="sub">
        Voordat we ook maar één telefoontje plegen, bepalen we samen de doelgroep.
        Weten we bij wie we moeten zijn, dan zitten we direct in de goede hoek.
      </p>
    </div>
    <div class="reveal"><PipelineWidget /></div>
  </section>

  <!-- 7 stappen -->
  <section class="section line">
    <div class="head">
      <div class="reveal">
        <span class="eyebrow">Zo werken wij</span>
        <h2 class="headline">Zeven stappen. Eén <span class="serif">doel</span><span class="d">.</span></h2>
      </div>
      <p class="lede reveal">
        Elke week halen we op welke signalen, functietitels en branches het beste
        werken, en sturen we bij. Heldere stappen, eerlijke verwachtingen.
      </p>
    </div>
    <ol class="steplist reveal">
      {
        steps.map((s) => (
          <li class="stepitem">
            <span class="stepitem-n">{s.n}</span>
            <h3 class="stepitem-title" set:html={s.t} />
            <p class="stepitem-desc" set:html={s.p} />
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Manifest (donker + foto) -->
  <section class="section pair dark on-dark">
    <div class="reveal">
      <Figure src="/assets/hens-arms-bench.jpeg" alt="Hens van LINK." ratio="4 / 5" radius="16px" position="50% 18%" />
    </div>
    <div class="reveal manifest-copy">
      <span class="eyebrow">Ons uitgangspunt</span>
      <h2 class="headline"><span class="serif">Kwaliteit</span> boven kwantiteit<span class="d">.</span></h2>
      <p class="lede">
        Wij sturen niet op aantallen, maar op afspraken die converteren naar
        klanten. Liever één gesprek met de juiste beslisser dan tien afspraken
        die nergens toe leiden.
      </p>
      <p class="lede">
        Daarom verdiepen we ons eerst in jouw bedrijf en doelgroep. Zo komen we
        met het juiste verhaal, bij de juiste persoon, op het juiste moment.
      </p>
      <p class="manifest-pull">"Geen grote beloftes. Gewoon een aanpak die werkt."</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="cta-block reveal">
      <span class="eyebrow">Klaar om te beginnen?</span>
      <h2 class="display">Vertel ons wat je <span class="serif">doet</span><span class="d">.</span></h2>
      <p class="lede">
        Bij wie wil je aan tafel zitten? Wat zijn je groeiambities? Stuur ons een
        berichtje of bel gewoon. We reageren snel en zonder gedoe.
      </p>
      <div class="actions">
        <a class="btn" href="/contact" data-magnetic>Plan een kennismaking <span class="arw">→</span></a>
        <a class="link" href="/diensten">Bekijk diensten</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(40px, 5vw, 80px);
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .manifest-copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .manifest-pull {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--blue);
    font-size: clamp(19px, 1.7vw, 25px);
    margin: 6px 0 0;
  }
  .cta-block {
    grid-column: 1 / 9;
    display: flex;
    flex-direction: column;
    gap: 22px;
    align-items: flex-start;
  }
  @media (max-width: 860px) {
    .cta-block {
      grid-column: 1 / -1;
    }
  }
</style>
