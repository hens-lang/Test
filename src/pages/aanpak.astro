---
import Base from '@/layouts/Base.astro';
import Chapter from '@/components/Chapter.astro';
import Duotone from '@/components/Duotone.astro';
import PipelineWidget from '@/components/widgets/PipelineWidget.astro';

const index = [
  { n: '01', label: 'Ideale klant' },
  { n: '02', label: '7 stappen' },
  { n: '03', label: 'Uitgangspunt' },
  { n: '04', label: 'Beginnen' },
];

const steps = [
  { n: '01', t: 'We verdiepen ons in jouw <em>bedrijf</em>', p: 'Wat verkoop je, wat onderscheidt je, en wie zit er nu al aan tafel? Hoe scherper het verhaal, hoe gerichter de outreach. <strong>Geen oppervlakkige briefing.</strong>' },
  { n: '02', t: 'We bepalen samen het <em>groeidoel</em>', p: 'Hoeveel afspraken? Welke omzet? Tegen welk tempo? Eerst helder, dan pas in actie. We werken vanuit een <strong>concreet doel</strong>, niet vanuit een vaag voorgevoel.' },
  { n: '03', t: 'We bepalen samen een <em>doelgroep</em>', p: 'Hier nemen we ruim de tijd voor. Want als we weten bij wie we moeten zijn, zitten we direct in de goede hoek. We sturen bij tot het <strong>ideale klantprofiel</strong> klopt.' },
  { n: '04', t: 'We stellen een <em>prospectlijst</em> samen', p: 'Geen gekochte database. Een handgemaakte lijst met bedrijven waar jij echt aan tafel wilt komen. We zoeken, vergelijken en beoordelen, tot de lijst klopt.' },
  { n: '05', t: 'De juiste beslisser bereiken', p: 'Een goed voorbereide aanpak die past bij jouw bedrijf en verhaal. We zoeken de juiste beslisser, en spreken hem of haar aan op de juiste manier.' },
  { n: '06', t: 'Interesse polsen en <em>kwalificeren</em>', p: 'We brengen alleen door wat écht een gesprek waard is. Liever één goede afspraak dan tien middelmatige. <strong>Volume is geen doel op zich</strong>, kwaliteit wel.' },
  { n: '07', t: 'De afspraak inplannen', p: 'Jij doet waar je goed in bent: het gesprek voeren en de deal sluiten. Wij blijven beschikbaar om mee te denken en bij te sturen.' },
];
---

<Base
  title="Onze aanpak in 7 stappen | LINK. B2B acquisitie"
  description="Van doelgroep bepalen tot de afspraak in jouw agenda: ontdek hoe LINK. in zeven heldere stappen werkt aan kwalitatieve B2B-afspraken die ertoe doen."
  path="/aanpak"
  index={index}
>
  <!-- 01 — Hero -->
  <section class="page-hero" id="h01">
    <div class="ph-copy reveal">
      <Chapter n="01" label="Onze aanpak" />
      <h1 class="h-giant">Eerst begrijpen wie je <em>ideale</em> klant is<span class="dot">.</span></h1>
      <p class="lede-xl">
        Voordat we ook maar één telefoontje plegen, bepalen we samen de doelgroep.
        Hier nemen we ruim de tijd voor. Weten we bij wie we moeten zijn, dan
        zitten we direct in de goede hoek.
      </p>
    </div>
    <div class="ph-widget reveal">
      <PipelineWidget />
    </div>
  </section>

  <!-- 02 — 7 stappen -->
  <section class="mag-sec" id="h02">
    <div class="split-head reveal">
      <div>
        <Chapter n="02" label="Zo werken wij" />
        <h2 class="h-section">Zeven stappen.<br />Eén <em>doel</em><span class="dot">.</span></h2>
      </div>
      <p class="lede-xl">
        Elke week halen we uit de gesprekken op welke signalen, functietitels en
        branches het beste werken, en sturen we bij. Heldere stappen, eerlijke
        verwachtingen.
      </p>
    </div>
    <ol class="steps reveal" style="margin-top: clamp(32px,4vw,64px)">
      {
        steps.map((s) => (
          <li class="step">
            <span class="step-n">{s.n}</span>
            <div class="step-body">
              <h3 set:html={s.t} />
              <p set:html={s.p} />
            </div>
            <i class="node sm" />
          </li>
        ))
      }
    </ol>
  </section>

  <!-- 03 — Uitgangspunt (manifest, donker + duotone) -->
  <section class="manifest on-dark" id="h03">
    <div class="manifest-media reveal">
      <Duotone src="/assets/hens-arms-bench.jpeg" alt="Hens" ratio="4 / 5" caption="ONS UITGANGSPUNT" position="50% 18%" />
    </div>
    <div class="manifest-copy reveal">
      <Chapter n="03" label="Ons uitgangspunt" />
      <h2 class="h-display"><em>Kwaliteit</em> boven kwantiteit<span class="dot">.</span></h2>
      <p class="lede-xl">
        Wij sturen niet op aantallen, maar op afspraken die converteren naar
        klanten. Liever één gesprek met de juiste beslisser dan tien afspraken
        die nergens toe leiden.
      </p>
      <p class="lede-xl">
        Daarom verdiepen we ons eerst in jouw bedrijf en doelgroep. Zo komen we
        met het juiste verhaal, bij de juiste persoon, op het juiste moment.
      </p>
      <p class="manifest-pull">"Geen grote beloftes. Gewoon een aanpak die werkt."</p>
    </div>
  </section>

  <!-- 04 — Beginnen -->
  <section class="mag-sec cta-sec" id="h04">
    <Chapter n="04" label="Klaar om te beginnen?" />
    <h2 class="h-display">Vertel ons wat je <em>doet</em><span class="dot">.</span></h2>
    <p class="lede-xl">
      Bij wie wil je aan tafel zitten? Wat zijn je groeiambities? Stuur ons een
      berichtje of bel gewoon. We reageren snel en zonder gedoe.
    </p>
    <div class="hero-cta">
      <a class="ebtn" href="/contact">Plan een kennismaking <span class="arw">→</span></a>
      <a class="ebtn ghost" href="/diensten">Bekijk diensten</a>
    </div>
  </section>
</Base>

<style>
  .page-hero {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(40px, 5vw, 80px);
    align-items: center;
    padding: clamp(40px, 6vw, 96px) var(--rail) clamp(48px, 6vw, 96px);
  }
  .ph-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .split-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: end;
  }
  .manifest {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    padding: clamp(60px, 8vw, 130px) var(--rail);
  }
  .manifest-media :global(.duo) {
    min-height: 52vh;
  }
  .manifest-copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .manifest-pull {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--blue);
    font-size: clamp(20px, 1.8vw, 26px);
    margin: 6px 0 0;
  }
  .cta-sec {
    display: flex;
    flex-direction: column;
    gap: 22px;
    align-items: flex-start;
  }
  .hero-cta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  @media (max-width: 900px) {
    .page-hero {
      grid-template-columns: 1fr;
    }
    .split-head {
      grid-template-columns: 1fr;
    }
    .manifest {
      grid-template-columns: 1fr;
    }
  }
</style>
