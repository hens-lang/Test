---
/**
 * CONCEPT 3 — verfijnd & professioneel (de middenweg).
 * Clean, veel witruimte, alleen merkblauw als accent. Subtiele craft:
 * onderstreping-groeit-naar-punt, zachte reveals, ingetogen magnetische CTA,
 * nette fotografie, kleine status-chip. Geen custom cursor/marquee/bounce.
 */
import '@/styles/tokens.css';

const doen = [
  { n: '01', t: 'We bepalen je ideale klant', p: 'Branche, omvang en de juiste beslisser. Scherp, voordat er iemand belt.' },
  { n: '02', t: 'Wij bellen ze persoonlijk', p: 'Goed voorbereid en in jouw verhaal. Geen script, geen call center.' },
  { n: '03', t: 'Jij zit aan tafel', p: 'De afspraak staat in je agenda, met de context van het gesprek erbij.' },
];
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Concept verfijnd — LINK.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Nav -->
    <header class="nnav">
      <a class="nlogo" href="#">LINK<span class="d">.</span></a>
      <nav class="nnav-links">
        <a href="#" class="ln">Aanpak</a>
        <a href="#" class="ln">Wat we doen</a>
        <a href="#" class="ln">Ons verhaal</a>
        <a href="#" class="ln">Contact</a>
      </nav>
      <a class="nnav-cta" href="#" data-magnetic>Even kennismaken <span class="arw">→</span></a>
    </header>

    <main>
      <!-- HERO -->
      <section class="nhero">
        <div class="nhero-copy reveal">
          <span class="eyebrow">B2B sales partner · Sinds 2025</span>
          <h1>Dè partner van <span class="serif">B2B</span> bedrijven<span class="d">.</span></h1>
          <p class="sub">
            Wij brengen je persoonlijk aan tafel bij de juiste beslisser. Jij
            voert het gesprek, wij zorgen dat het er komt.
          </p>
          <div class="nhero-cta">
            <a class="nbtn" href="#" data-magnetic>Plan een kennismaking <span class="arw">→</span></a>
            <a class="ln big" href="#">Ons verhaal</a>
          </div>
          <div class="nhero-meta">
            <span><b>1</b> vast gezicht</span>
            <span><b>0</b> lange contracten</span>
            <span><b>100%</b> persoonlijk</span>
          </div>
        </div>
        <div class="nhero-photo reveal">
          <div class="frame">
            <img src="/assets/hens-call-navy.jpeg" alt="Hens van LINK." onerror="this.style.display='none'" />
            <span class="ph-fallback">HENS</span>
          </div>
          <span class="status"><i></i> Nu ruimte voor 2 nieuwe partners</span>
        </div>
      </section>

      <!-- WAT WE DOEN -->
      <section class="nsec">
        <div class="nsec-head reveal">
          <div>
            <span class="eyebrow">Wat we doen</span>
            <h2>Wij bellen. Jij <span class="serif">verkoopt</span><span class="d">.</span></h2>
          </div>
          <p class="lede">
            Wij doen de telefonische acquisitie voor B2B-bedrijven. Wij leggen het
            eerste contact, jij voert het gesprek dat ertoe doet.
          </p>
        </div>
        <div class="ncols reveal">
          {
            doen.map((s) => (
              <div class="ncol">
                <span class="ncol-n">{s.n}</span>
                <h3>{s.t}</h3>
                <p>{s.p}</p>
                <a class="ln" href="#">Lees meer</a>
              </div>
            ))
          }
        </div>
      </section>

      <!-- STATEMENT -->
      <section class="nstate reveal">
        <p>
          Jij bent goed in het gesprek. Niet in de honderd
          <span class="serif">telefoontjes</span> ervoor<span class="d">.</span>
        </p>
      </section>

      <!-- CTA -->
      <section class="ncta">
        <div class="ncta-in reveal">
          <div>
            <span class="eyebrow">Even kennismaken</span>
            <h2>We drinken graag een kop <span class="serif">koffie</span> met je<span class="d">.</span></h2>
          </div>
          <div class="ncta-right">
            <p class="lede">Een kop koffie en eerlijk advies, of we nu samenwerken of niet. Bel of mail gerust.</p>
            <a class="nbtn" href="#" data-magnetic>Plan een kennismaking <span class="arw">→</span></a>
          </div>
        </div>
      </section>
    </main>

    <footer class="nfoot">
      <span class="nlogo">LINK<span class="d">.</span></span>
      <span>© 2026 · Alphen aan den Rijn · (0172) 27 10 08</span>
    </footer>

    <script is:inline>
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var fine = window.matchMedia('(pointer: fine)').matches;
        // Subtiele reveals
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
        document.querySelectorAll('.reveal').forEach(function (el) {
          if (reduce) el.classList.add('in'); else io.observe(el);
        });
        // Ingetogen magnetische CTA
        if (fine && !reduce) {
          document.querySelectorAll('[data-magnetic]').forEach(function (el) {
            el.addEventListener('mousemove', function (e) {
              var r = el.getBoundingClientRect();
              el.style.transform = 'translate(' + (e.clientX - (r.left + r.width / 2)) * 0.18 + 'px,' + (e.clientY - (r.top + r.height / 2)) * 0.18 + 'px)';
            });
            el.addEventListener('mouseleave', function () { el.style.transform = ''; });
          });
        }
      })();
    </script>

    <style is:global>
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-sans);
        font-size: 17px;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      a { color: inherit; text-decoration: none; }
      .d { color: var(--blue); }
      .serif { font-family: var(--font-serif); font-style: italic; font-weight: 400; letter-spacing: -0.01em; }
      .arw { display: inline-block; transition: transform 0.25s var(--ease); }
      [data-magnetic] { will-change: transform; }

      .eyebrow {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 11.5px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--mute);
      }
      .lede { font-size: clamp(18px, 1.4vw, 21px); line-height: 1.55; color: var(--ink-soft); margin: 0; max-width: 46ch; }

      /* Onderstreping groeit naar een punt (subtiele signature) */
      .ln {
        position: relative;
        font-weight: 600;
        color: var(--ink);
        padding-bottom: 3px;
      }
      .ln::after {
        content: '';
        position: absolute;
        left: 0; bottom: 0;
        height: 1.5px;
        width: 0;
        background: var(--blue);
        transition: width 0.3s var(--ease);
      }
      .ln:hover { color: var(--blue-deep); }
      .ln:hover::after { width: 100%; }
      .ln.big { font-size: 16px; }

      /* Nav */
      .nnav {
        position: sticky;
        top: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 22px clamp(24px, 6vw, 110px);
        background: color-mix(in oklab, var(--bg) 80%, transparent);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--line);
      }
      .nlogo { font-weight: 900; font-size: 23px; letter-spacing: -0.05em; }
      .nlogo .d { color: var(--blue); }
      .nnav-links { display: flex; gap: 34px; font-size: 15px; }
      .nnav-cta {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        background: var(--ink);
        color: var(--paper);
        padding: 12px 22px;
        border-radius: 999px;
        font-weight: 600;
        font-size: 14.5px;
        transition: background 0.2s;
      }
      .nnav-cta:hover { background: var(--blue); color: var(--ink); }
      .nnav-cta:hover .arw { transform: translateX(4px); }

      /* Hero */
      .nhero {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: clamp(40px, 6vw, 90px);
        align-items: center;
        padding: clamp(56px, 8vw, 120px) clamp(24px, 6vw, 110px) clamp(60px, 8vw, 120px);
      }
      .nhero-copy { display: flex; flex-direction: column; gap: 26px; }
      .nhero h1 {
        font-weight: 800;
        font-size: clamp(48px, 6vw, 104px);
        line-height: 0.98;
        letter-spacing: -0.045em;
        margin: 8px 0 0;
        max-width: 15ch;
      }
      .sub { font-size: clamp(18px, 1.5vw, 23px); line-height: 1.5; color: var(--ink-soft); max-width: 42ch; margin: 0; }
      .nhero-cta { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; }
      .nbtn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: var(--ink);
        color: var(--paper);
        padding: 17px 28px;
        border-radius: 999px;
        font-weight: 600;
        font-size: 15.5px;
        transition: background 0.2s, color 0.2s;
      }
      .nbtn:hover { background: var(--blue); color: var(--ink); }
      .nbtn:hover .arw { transform: translateX(4px); }
      .nhero-meta {
        display: flex;
        gap: clamp(20px, 3vw, 44px);
        margin-top: 8px;
        padding-top: 22px;
        border-top: 1px solid var(--line);
        flex-wrap: wrap;
        font-size: 14px;
        color: var(--mute);
      }
      .nhero-meta b { display: block; font-size: 30px; font-weight: 800; letter-spacing: -0.03em; color: var(--ink); }

      .nhero-photo { position: relative; }
      .frame {
        position: relative;
        aspect-ratio: 4 / 5;
        border-radius: 20px;
        overflow: hidden;
        background: var(--bg-3);
        display: grid;
        place-items: center;
      }
      .frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
      .ph-fallback { font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.2em; color: var(--mute); }
      .status {
        position: absolute;
        left: 18px; bottom: 18px;
        display: inline-flex;
        align-items: center;
        gap: 9px;
        background: color-mix(in oklab, var(--paper) 92%, transparent);
        backdrop-filter: blur(6px);
        border: 1px solid var(--line-soft);
        padding: 10px 16px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 500;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      }
      .status i {
        width: 8px; height: 8px;
        background: var(--blue);
        border-radius: 50%;
        animation: pulse 1.8s ease-out infinite;
      }
      @keyframes pulse { 0%,100% { box-shadow: 0 0 0 0 rgba(41,176,242,.5);} 70%{ box-shadow:0 0 0 7px rgba(41,176,242,0);} }

      /* Sectie */
      .nsec { padding: clamp(60px, 8vw, 120px) clamp(24px, 6vw, 110px); }
      .nsec-head {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: clamp(32px, 5vw, 80px);
        align-items: end;
        margin-bottom: clamp(44px, 5vw, 72px);
      }
      .nsec-head h2 {
        font-weight: 800;
        font-size: clamp(36px, 4vw, 64px);
        letter-spacing: -0.04em;
        line-height: 1;
        margin: 14px 0 0;
      }
      .lede { padding-top: 16px; border-top: 1px solid var(--line); }
      .ncols {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: clamp(28px, 3vw, 56px);
      }
      .ncol {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding-top: 22px;
        border-top: 1px solid var(--line);
      }
      .ncol-n { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.12em; color: var(--blue-deep); }
      .ncol h3 { font-size: clamp(20px, 1.8vw, 26px); font-weight: 700; letter-spacing: -0.02em; margin: 0; line-height: 1.2; }
      .ncol p { color: var(--ink-soft); font-size: 16px; line-height: 1.55; margin: 0; }
      .ncol .ln { margin-top: 6px; font-size: 14px; }

      /* Statement (rustpunt) */
      .nstate {
        padding: clamp(70px, 10vw, 150px) clamp(24px, 6vw, 110px);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }
      .nstate p {
        font-weight: 800;
        font-size: clamp(30px, 4.4vw, 76px);
        line-height: 0.98;
        letter-spacing: -0.045em;
        margin: 0;
        max-width: 20ch;
      }

      /* CTA */
      .ncta { padding: clamp(70px, 9vw, 140px) clamp(24px, 6vw, 110px); }
      .ncta-in {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: clamp(32px, 5vw, 80px);
        align-items: end;
      }
      .ncta-in h2 {
        font-weight: 800;
        font-size: clamp(38px, 5vw, 80px);
        letter-spacing: -0.045em;
        line-height: 0.98;
        margin: 14px 0 0;
        max-width: 13ch;
      }
      .ncta-right { display: flex; flex-direction: column; gap: 26px; align-items: flex-start; }

      .nfoot {
        background: var(--ink);
        color: var(--dark-mute);
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 28px clamp(24px, 6vw, 110px);
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.08em;
        flex-wrap: wrap;
        gap: 12px;
      }
      .nfoot .nlogo { color: var(--paper); }

      /* Reveals */
      .reveal { opacity: 0; transform: translateY(22px); transition: opacity 0.7s var(--ease), transform 0.7s var(--ease); }
      .reveal.in { opacity: 1; transform: none; }

      @media (max-width: 900px) {
        .nnav-links { display: none; }
        .nhero { grid-template-columns: 1fr; }
        .nsec-head { grid-template-columns: 1fr; }
        .ncols { grid-template-columns: 1fr; }
        .ncta-in { grid-template-columns: 1fr; }
      }
      @media (prefers-reduced-motion: reduce) {
        .status i { animation: none; }
      }
    </style>
  </body>
</html>
