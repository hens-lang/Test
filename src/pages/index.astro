---
import Base from '@/layouts/Base.astro';
import Figure from '@/components/Figure.astro';
import Signature from '@/components/Signature.astro';
import AgendaWidget from '@/components/widgets/AgendaWidget.astro';
import { site } from '@/lib/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'LINK.',
  description:
    'Persoonlijke B2B acquisitie en leadgeneratie. Telefonische acquisitie die structureel klanten oplevert.',
  url: site.url + '/',
  email: site.contact.email,
  telephone: '+31172271008',
  image: site.url + '/assets/logo-square.png',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.contact.street,
    postalCode: site.contact.postalCode,
    addressLocality: site.contact.city,
    addressCountry: site.contact.country,
  },
  areaServed: 'NL',
  knowsAbout: ['B2B acquisitie', 'leadgeneratie', 'telefonische acquisitie', 'salesafspraken'],
};

const doen = [
  { n: '01', t: 'We bepalen je ideale klant', p: 'Branche, omvang en de juiste beslisser. Scherp, <strong>voordat</strong> er iemand belt.' },
  { n: '02', t: 'Wij bellen ze persoonlijk', p: 'Goed voorbereid en in jouw verhaal. Geen script, geen call center.' },
  { n: '03', t: 'Jij zit aan tafel', p: 'De afspraak staat in je agenda, met de context van het gesprek erbij.' },
];

const anders = [
  { n: '01', t: 'Wij groeien mee', p: 'Geen bureau op afstand, maar een partner aan jouw kant van de tafel. Jouw doelen worden onze doelen.' },
  { n: '02', t: 'Wij kennen jouw markt', p: 'We verdiepen ons eerst in jouw bedrijf en doelgroep. Zo komen we met het juiste verhaal bij de juiste beslisser.' },
  { n: '03', t: 'Een select aantal partners', p: 'Zodat elke samenwerking volle aandacht krijgt. Geen lange contracten.' },
];
---

<Base
  title="LINK. | Persoonlijke B2B acquisitie & leadgeneratie"
  description={site.description}
  path="/"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="section pair hero">
    <div class="hero-copy reveal">
      <span class="eyebrow">B2B sales partner · Sinds 2025</span>
      <h1 class="display">Dè partner van <span class="serif">B2B</span> bedrijven<span class="d">.</span></h1>
      <p class="sub">
        Wij brengen je persoonlijk aan tafel bij de juiste beslisser. Jij voert
        het gesprek, wij zorgen dat het er komt.
      </p>
      <div class="actions">
        <a class="btn" href="/contact" data-magnetic>Plan een kennismaking <span class="arw">→</span></a>
        <a class="link" href="/verhaal">Ons verhaal</a>
      </div>
      <div class="meta">
        <span><b>1</b> vast gezicht</span>
        <span><b>0</b> lange contracten</span>
        <span><b>100%</b> persoonlijk</span>
      </div>
    </div>
    <div class="hero-media reveal">
      <div class="photo-wrap">
        <Figure src="/assets/hens-call-navy.jpeg" alt="Hens van LINK. aan de telefoon" ratio="4 / 5" radius="16px" eager />
        <span class="status"><i></i> Nu ruimte voor 2 nieuwe partners</span>
      </div>
    </div>
  </section>

  <!-- Even voorstellen (persoonlijk, warm welkom) -->
  <section class="section line pair intro">
    <div class="reveal">
      <div class="photo-wrap">
        <Figure src="/assets/hens-notebook-smile.jpeg" alt="Hens van LINK." ratio="4 / 5" radius="16px" />
      </div>
    </div>
    <div class="reveal intro-copy">
      <span class="eyebrow">Even voorstellen</span>
      <h2 class="headline">Geen bureau. <span class="serif">Gewoon</span> ik<span class="d">.</span></h2>
      <p class="lede">
        Ik ben Hens. Geen bureau op afstand, maar iemand die jouw verhaal kent en
        zelf de telefoon pakt. Het liefst begin ik met een kop koffie, even kijken
        of het klikt. Past het niet, dan zeg ik dat ook gewoon.
      </p>
      <Signature />
    </div>
  </section>

  <!-- Wat we doen -->
  <section class="section">
    <div class="head">
      <div class="reveal">
        <span class="eyebrow">Wat we doen</span>
        <h2 class="headline">Wij bellen. Jij <span class="serif">verkoopt</span><span class="d">.</span></h2>
      </div>
      <p class="lede reveal">
        Wij doen de telefonische acquisitie voor B2B-bedrijven. Wij leggen het
        eerste contact, jij voert het gesprek dat ertoe doet.
      </p>
    </div>
    <div class="cols reveal">
      {
        doen.map((s) => (
          <div class="col">
            <span class="col-n">{s.n}</span>
            <h3>{s.t}</h3>
            <p set:html={s.p} />
            <a class="link" href="/diensten">Lees meer</a>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Statement (herkenning) -->
  <section class="section dark on-dark">
    <div class="statement reveal">
      <span class="eyebrow">Even eerlijk</span>
      <p>Je weet dat je moet bellen. Je komt er alleen <span class="serif">nooit</span> aan toe<span class="d">.</span></p>
    </div>
  </section>

  <!-- Wat ons anders maakt -->
  <section class="section">
    <div class="head">
      <div class="reveal">
        <span class="eyebrow">Geen bureau. Een partner.</span>
        <h2 class="headline">Wat ons <span class="serif">anders</span> maakt<span class="d">.</span></h2>
      </div>
      <p class="lede reveal">
        Niet tien afspraken die nergens toe leiden, maar één die klopt. Met de
        juiste persoon, op het juiste moment.
      </p>
    </div>
    <div class="cols reveal">
      {
        anders.map((a) => (
          <div class="col">
            <span class="col-n">{a.n}</span>
            <h3>{a.t}</h3>
            <p>{a.p}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Bewijs: agenda -->
  <section class="section line pair">
    <div class="reveal">
      <span class="eyebrow">Vandaag bij LINK.</span>
      <h2 class="headline">Echte afspraken. <span class="serif">Geboekt</span> voor partners<span class="d">.</span></h2>
      <p class="lede" style="margin-top:20px;max-width:42ch">
        Wij leggen het eerste contact met de juiste beslisser. Jij voert het
        gesprek dat ertoe doet.
      </p>
    </div>
    <div class="reveal"><AgendaWidget /></div>
  </section>

  <!-- Koffie CTA -->
  <section class="section pair">
    <div class="reveal">
      <div class="photo-wrap">
        <Figure src="/assets/hens-coffee.jpeg" alt="Hens bij een kop koffie" ratio="4 / 5" radius="16px" position="center 20%" />
      </div>
    </div>
    <div class="reveal close-copy">
      <span class="eyebrow">Even kennismaken</span>
      <h2 class="display">We drinken graag een kop <span class="serif">koffie</span> met je<span class="d">.</span></h2>
      <p class="lede">
        Een kop koffie en eerlijk advies, of we nu samenwerken of niet. Bel of
        mail gerust, we reageren snel.
      </p>
      <div class="actions">
        <a class="btn" href="/contact" data-magnetic>Plan een kennismaking <span class="arw">→</span></a>
        <a class="link" href={`tel:${site.contact.phoneHref}`}>{site.contact.phoneDisplay}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(40px, 5vw, 80px);
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .photo-wrap {
    position: relative;
  }
  .close-copy {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .intro-copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .intro-copy .sign {
    margin-top: 8px;
  }
</style>
