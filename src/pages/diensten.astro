---
import Base from '@/layouts/Base.astro';
import Chapter from '@/components/Chapter.astro';
import Duotone from '@/components/Duotone.astro';
import { site } from '@/lib/site';

const index = [
  { n: '01', label: 'Wij bellen' },
  { n: '02', label: 'Acquisitie' },
  { n: '03', label: 'Wie het doet' },
  { n: '04', label: 'Portaal' },
  { n: '05', label: 'Opbrengst' },
  { n: '06', label: 'Kennismaken' },
];

const specs = [
  { k: 'Voor wie', v: 'B2B-bedrijven die hun salesmotor willen opzetten of versterken.' },
  { k: 'Wat je krijgt', v: 'Afspraken bij de juiste beslisser, <em>persoonlijk</em> gelegd.' },
  { k: 'Hoe', v: 'Geen script, geen call center. Eén vast gezicht in jouw verhaal.' },
  { k: 'Voorwaarden', v: 'Maandelijks opzegbaar. Geen lange contracten of hoge investering vooraf.' },
];

const portaal = [
  { k: 'Leads', h: 'Elk gesprek gelogd', p: 'Wie we spraken, wat er gezegd is en wat de volgende stap is.' },
  { k: 'Afspraken', h: 'Direct in je agenda', p: 'Met bedrijf, contactpersoon en de context van het gesprek.' },
  { k: 'Rapportage', h: 'Elke week een overzicht', p: 'Wat er is gebeurd en wat het heeft opgeleverd.' },
  { k: 'Facturen', h: 'Geen verrassingen', p: 'Je ziet precies waarvoor je betaalt.' },
];

const opbrengst = [
  { n: '01', t: 'Jouw team houdt tijd over', p: 'Het koud bellen regelen wij. Jouw team houdt zich bezig met de warme gesprekken.' },
  { n: '02', t: 'Geen risico vooraf', p: 'Geen lange contracten of hoge investering vooraf. Maandelijks opzegbaar.' },
];
---

<Base
  title="Telefonische acquisitie voor B2B-bedrijven | LINK."
  description="Persoonlijke telefonische acquisitie voor B2B-bedrijven. Wij regelen de afspraken bij de juiste beslissers, jij sluit de deals."
  path="/diensten"
  index={index}
>
  <!-- 01 — Hero -->
  <section class="page-hero" id="h01">
    <div class="ph-copy reveal">
      <Chapter n="01" label="Wat we doen" />
      <h1 class="h-giant">Wij bellen.<br />Jij <em>verkoopt</em><span class="dot">.</span></h1>
      <p class="lede-xl">
        Wij bellen jouw ideale klanten zelf op, goed voorbereid en in jouw
        verhaal. Jij voert het gesprek dat ertoe doet.
      </p>
      <div class="hero-cta">
        <a class="ebtn" href="/contact">Plan een kennismaking <span class="arw">→</span></a>
        <a class="ebtn ghost" href="#h02">Hoe het werkt</a>
      </div>
    </div>
    <div class="ph-widget reveal">
      <div class="call-card">
        <div class="cc-head"><span class="rec"></span> LIVE GESPREK</div>
        <div class="cc-who">
          <span class="cc-av">HB</span>
          <div class="cc-txt">
            <span class="cc-name">Beslisser · Logistiek</span>
            <span class="cc-role">Regio Utrecht</span>
          </div>
          <span class="cc-timer">02:14</span>
        </div>
        <div class="cc-wave" aria-hidden="true">
          {Array.from({ length: 20 }).map(() => <span></span>)}
        </div>
        <p class="cc-quote">"Klinkt interessant. <em>Stuur maar een voorstel</em>, dan plannen we een afspraak."</p>
      </div>
    </div>
  </section>

  <!-- 02 — Telefonische acquisitie -->
  <section class="service" id="h02">
    <div class="service-copy reveal">
      <Chapter n="02" label="De dienst" />
      <h2 class="h-section">Telefonische <em>acquisitie</em><span class="dot">.</span></h2>
      <p class="lede-xl">
        Wij bellen jouw ideale klanten persoonlijk op, goed voorbereid en in jouw
        verhaal. Alleen wat écht een gesprek waard is, brengen we door.
      </p>
      <div class="specs">
        {
          specs.map((s) => (
            <div class="spec">
              <span class="spec-k">{s.k}</span>
              <span class="spec-v" set:html={s.v} />
            </div>
          ))
        }
      </div>
    </div>
    <div class="service-note reveal">
      <p class="note">
        <b>Een echt gesprek.</b> Geen script dat wordt afgerateld, maar een
        voorbereid gesprek dat past bij jouw verhaal. Eén vast gezicht dat namens
        jou belt en aan tafel zit.
      </p>
    </div>
  </section>

  <!-- 03 — Wie het doet -->
  <section class="split-photo" id="h03">
    <div class="sp-media reveal">
      <Duotone src="/assets/hens-call-navy.jpeg" alt="Hens aan de telefoon" ratio="4 / 5" caption="DE TELEFOON" />
    </div>
    <div class="sp-copy reveal">
      <Chapter n="03" label="Wie het doet" />
      <h2 class="h-section">Geen call center. <em>Eén</em> gezicht<span class="dot">.</span></h2>
      <p class="lede-xl">
        Bij LINK. spreek je geen tussenlaag. Je weet altijd precies wie er namens
        jou belt en aan tafel zit.
      </p>
      <ul class="mini-list">
        <li><b>Voorbereid.</b> We verdiepen ons in jouw markt voordat we bellen.</li>
        <li><b>Persoonlijk.</b> Geen script. Een echt gesprek, met jouw verhaal.</li>
        <li><b>Vast contact.</b> Altijd hetzelfde gezicht.</li>
      </ul>
    </div>
  </section>

  <!-- 04 — Partnerportaal -->
  <section class="split-photo reverse" id="h04">
    <div class="sp-copy reveal">
      <Chapter n="04" label="Altijd inzicht" />
      <h2 class="h-section">Jouw eigen <em>partnerportaal</em><span class="dot">.</span></h2>
      <p class="lede-xl">
        Je hoeft nooit te vragen hoe het ervoor staat. Alles wat wij doen staat
        live in je eigen omgeving, ook als het even tegenzit.
      </p>
      <div class="portaal-grid">
        {
          portaal.map((p) => (
            <div class="portaal-item">
              <span class="pi-k">{p.k}</span>
              <b>{p.h}</b>
              <span>{p.p}</span>
            </div>
          ))
        }
      </div>
      <a class="ebtn ghost" href={site.portal.url} target="_blank" rel="noopener" style="margin-top:6px">
        Bekijk het partnerportaal <span class="arw">→</span>
      </a>
    </div>
    <div class="sp-media reveal">
      <Duotone src="/assets/portaal-laptop.jpeg" alt="Het partnerportaal op een laptop" ratio="4 / 3" caption="LOGBOEK" blur />
    </div>
  </section>

  <!-- 05 — Wat levert het op -->
  <section class="mag-sec" id="h05">
    <div class="split-head reveal">
      <div>
        <Chapter n="05" label="Wat levert het op" />
        <h2 class="h-section">Meer <em>warme</em> gesprekken<span class="dot">.</span></h2>
      </div>
      <p class="lede-xl">
        Samen bepalen we bij wie jij aan tafel wil zitten. Daarna gaan wij aan de
        slag, en blijven we bijsturen op wat we ophalen.
      </p>
    </div>
    <div class="trio reveal-stagger">
      {
        opbrengst.map((o) => (
          <div class="trio-item">
            <span class="trio-n">{o.n}</span>
            <h3>{o.t}</h3>
            <p>{o.p}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 06 — CTA -->
  <section class="mag-sec cta-sec" id="h06">
    <Chapter n="06" label="Klaar om te beginnen?" />
    <h2 class="h-display">Wij bellen. Jij <em>verkoopt</em><span class="dot">.</span></h2>
    <p class="lede-xl">Stuur ons een berichtje of bel gewoon. We reageren snel en zonder gedoe.</p>
    <div class="hero-cta">
      <a class="ebtn" href="/contact">Plan een kennismaking <span class="arw">→</span></a>
      <a class="ebtn ghost" href="/aanpak">Bekijk de aanpak</a>
    </div>
  </section>
</Base>

<style>
  .page-hero {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(40px, 5vw, 80px);
    align-items: center;
    padding: clamp(40px, 6vw, 96px) var(--rail) clamp(48px, 6vw, 96px);
  }
  .ph-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .hero-cta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  /* Call-card */
  .call-card {
    background: var(--paper);
    border: 1px solid var(--line-soft);
    border-radius: var(--r-card);
    padding: 22px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .cc-head {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--mute);
  }
  .rec {
    width: 8px;
    height: 8px;
    background: #e54b4b;
    border-radius: 50%;
    animation: pulse 1.8s ease-out infinite;
  }
  .cc-who {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .cc-av {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--blue), var(--blue-deep));
    color: var(--ink);
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 13px;
  }
  .cc-txt {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .cc-name {
    font-size: 14px;
    font-weight: 600;
  }
  .cc-role {
    font-size: 12px;
    color: var(--mute);
  }
  .cc-timer {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--blue-deep);
    font-weight: 600;
  }
  .cc-wave {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 30px;
  }
  .cc-wave span {
    flex: 1;
    background: linear-gradient(to top, var(--blue), var(--blue-deep));
    border-radius: 2px;
    min-height: 4px;
    transform-origin: bottom;
    animation: wave 1.4s ease-in-out infinite;
  }
  .cc-wave span:nth-child(2n) { animation-delay: -0.4s; }
  .cc-wave span:nth-child(3n) { animation-delay: -0.8s; }
  .cc-wave span:nth-child(4n) { animation-delay: -1.1s; }
  .cc-wave span:nth-child(5n) { animation-delay: -0.2s; }
  @keyframes wave {
    0%, 100% { transform: scaleY(0.35); opacity: 0.55; }
    50% { transform: scaleY(1); opacity: 1; }
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.15); }
  }
  .cc-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 14px;
    color: var(--ink-soft);
    line-height: 1.4;
    padding-top: 10px;
    border-top: 1px dashed var(--line);
    margin: 0;
  }
  .cc-quote em {
    color: var(--blue-deep);
  }

  /* Service */
  .service {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(40px, 6vw, 100px);
    align-items: start;
    padding: clamp(60px, 8vw, 130px) var(--rail);
    border-top: 1px solid var(--line);
  }
  .service-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .specs {
    margin-top: 12px;
  }
  .spec {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 24px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
    align-items: baseline;
  }
  .spec:last-child {
    border-bottom: 1px solid var(--line);
  }
  .spec-k {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .spec-v {
    font-size: 17px;
    line-height: 1.45;
  }
  .spec-v :global(em) {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--blue-deep);
  }
  .service-note {
    position: sticky;
    top: 120px;
  }
  .note {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(20px, 1.8vw, 26px);
    line-height: 1.4;
    color: var(--ink);
    border-left: 2px solid var(--blue);
    padding-left: 22px;
    margin: 0;
  }
  .note b {
    font-family: var(--font-sans);
    font-style: normal;
    font-weight: 700;
    display: block;
    margin-bottom: 6px;
  }

  /* Split-photo */
  .split-photo {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(40px, 5vw, 96px);
    align-items: center;
    padding: clamp(56px, 7vw, 120px) var(--rail);
    border-top: 1px solid var(--line);
  }
  .split-photo.reverse {
    grid-template-columns: 1.1fr 0.9fr;
  }
  .split-photo.reverse .sp-media {
    order: 2;
  }
  .sp-media :global(.duo) {
    min-height: 52vh;
  }
  .sp-copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .mini-list {
    list-style: none;
    padding: 0;
    margin: 4px 0 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .mini-list li {
    position: relative;
    padding-left: 20px;
    color: var(--ink-soft);
    font-size: 16px;
    line-height: 1.5;
  }
  .mini-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 7px;
    height: 7px;
    background: var(--blue);
    border-radius: 50%;
  }
  .mini-list b {
    color: var(--ink);
    font-weight: 600;
  }
  .portaal-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-top: 4px;
  }
  .portaal-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .pi-k {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue-deep);
  }
  .portaal-item b {
    font-size: 16px;
    font-weight: 700;
  }
  .portaal-item span:last-child {
    font-size: 14px;
    color: var(--ink-soft);
    line-height: 1.45;
  }

  .split-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: end;
  }
  .trio {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(28px, 3vw, 56px);
    margin-top: clamp(40px, 5vw, 72px);
  }
  .trio-item {
    border-top: 2px solid var(--ink);
    padding-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .trio-n {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--blue-deep);
  }
  .trio-item h3 {
    font-size: clamp(24px, 2.4vw, 36px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
    margin: 0;
  }
  .trio-item p {
    color: var(--ink-soft);
    font-size: 16px;
    line-height: 1.55;
    margin: 0;
    max-width: 40ch;
  }
  .cta-sec {
    display: flex;
    flex-direction: column;
    gap: 22px;
    align-items: flex-start;
  }

  @media (max-width: 900px) {
    .page-hero {
      grid-template-columns: 1fr;
    }
    .service {
      grid-template-columns: 1fr;
    }
    .service-note {
      position: static;
    }
    .split-photo,
    .split-photo.reverse {
      grid-template-columns: 1fr;
    }
    .split-photo.reverse .sp-media {
      order: 0;
    }
    .split-head {
      grid-template-columns: 1fr;
    }
    .trio {
      grid-template-columns: 1fr;
    }
    .portaal-grid {
      grid-template-columns: 1fr;
    }
    .spec {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
