---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import Figure from '@/components/Figure.astro';
import Split from '@/components/Split.astro';
import { site } from '@/lib/site';

const specs = [
  { k: 'Voor wie', v: 'B2B-bedrijven die hun salesmotor willen opzetten of versterken.' },
  { k: 'Wat je krijgt', v: 'Afspraken bij de juiste beslisser, <em>persoonlijk</em> gelegd.' },
  { k: 'Hoe', v: 'Geen script, geen call center. Eén vast gezicht in jouw verhaal.' },
  { k: 'Voorwaarden', v: 'Maandelijks opzegbaar. Geen lange contracten of hoge investering vooraf.' },
];

const portaal = [
  { k: 'Leads', h: 'Elk gesprek gelogd', p: 'Wie we spraken, wat er gezegd is en wat de volgende stap is.' },
  { k: 'Afspraken', h: 'Direct in je agenda', p: 'Met bedrijf, contactpersoon en de context van het gesprek.' },
  { k: 'Rapportage', h: 'Elke week een overzicht', p: 'Wat er is gebeurd en wat het heeft opgeleverd.' },
  { k: 'Facturen', h: 'Geen verrassingen', p: 'Je ziet precies waarvoor je betaalt.' },
];

const opbrengst = [
  { n: '01', h: 'Jouw team houdt tijd over', p: 'Het koud bellen regelen wij. Jouw team houdt zich bezig met de warme gesprekken.' },
  { n: '02', h: 'Geen risico vooraf', p: 'Geen lange contracten of hoge investering vooraf. Maandelijks opzegbaar.' },
];
---

<Base
  title="Telefonische acquisitie voor B2B-bedrijven | LINK."
  description="Persoonlijke telefonische acquisitie voor B2B-bedrijven. Wij regelen de afspraken bij de juiste beslissers, jij sluit de deals."
  path="/diensten"
>
  <!-- Hero -->
  <section class="page-hero">
    <div class="intro reveal">
      <span class="eyebrow">Wat we doen</span>
      <h1>Wij bellen. Jij <span class="it">verkoopt</span><span class="punc">.</span></h1>
      <p class="lede">
        Wij bellen jouw ideale klanten zelf op, goed voorbereid en in jouw
        verhaal. Jij voert het gesprek dat ertoe doet.
      </p>
      <div class="hero-actions">
        <a class="btn-primary" href="/contact">Plan een kennismaking <Icon name="arrow" class="arrow" /></a>
        <a class="btn-ghost" href="#telefonisch">Hoe het werkt</a>
      </div>
    </div>
    <div class="channels reveal">
      <a class="channel" href="#telefonisch">
        <span class="ch-ic"><Icon name="phone" size={22} /><span class="live-dot"></span></span>
        <span class="ch-text">
          <span class="ch-num">01</span>
          <span class="ch-name">Telefonische acquisitie</span>
          <span class="ch-sub">Persoonlijk, in jouw verhaal</span>
        </span>
        <span class="ch-arrow"><Icon name="arrow" size={18} /></span>
      </a>
      <a class="channel" href="#portaal">
        <span class="ch-ic"><Icon name="building" size={22} /></span>
        <span class="ch-text">
          <span class="ch-num">02</span>
          <span class="ch-name">Jouw partnerportaal</span>
          <span class="ch-sub">Altijd live inzicht</span>
        </span>
        <span class="ch-arrow"><Icon name="arrow" size={18} /></span>
      </a>
      <p class="ch-foot">Eén dienst, goed gedaan. <span class="it">Geen ruis.</span></p>
    </div>
  </section>

  <!-- Dienstdetail: telefonische acquisitie -->
  <section class="service-detail" id="telefonisch">
    <div class="service-grid">
      <div class="reveal">
        <span class="eyebrow">Telefonische acquisitie</span>
        <h2>Telefonische <span class="it">acquisitie</span><span class="punc">.</span></h2>
        <p class="service-lede">
          Wij bellen jouw ideale klanten persoonlijk op, goed voorbereid en in
          jouw verhaal. Alleen wat écht een gesprek waard is, brengen we door.
        </p>
        <div class="spec-list">
          {
            specs.map((s) => (
              <div class="spec">
                <span class="k">{s.k}</span>
                <span class="v" set:html={s.v} />
              </div>
            ))
          }
        </div>
      </div>

      <div class="visual reveal">
        <div class="call-card">
          <div class="head"><span class="rec-dot"></span> Live gesprek</div>
          <div class="who">
            <span class="avatar">HB</span>
            <div class="who-text">
              <span class="who-name">Beslisser · Logistiek</span>
              <span class="who-role">Regio Utrecht</span>
            </div>
            <span class="who-timer" data-timer>02:14</span>
          </div>
          <div class="waveform" aria-hidden="true">
            {Array.from({ length: 18 }).map(() => <span class="bar"></span>)}
          </div>
          <p class="transcript">"Klinkt interessant. <em>Stuur maar een voorstel</em>, dan plannen we een afspraak."</p>
        </div>
        <p class="visual-cap">
          <b>Een echt gesprek.</b> Geen script dat wordt afgerateld, maar een
          voorbereid gesprek dat past bij jouw verhaal.
        </p>
      </div>
    </div>
  </section>

  <!-- Wie het doet (split) -->
  <Split
    src="/assets/hens-call-navy.jpeg"
    alt="Hens aan de telefoon"
    ratio="4 / 5"
    tag="De telefoon"
    reverse
  >
    <span class="eyebrow">Wie het doet</span>
    <h2>Geen call center. <span class="it">Eén</span> vast gezicht<span class="punc">.</span></h2>
    <p>
      Bij LINK. spreek je geen tussenlaag. Je weet altijd precies wie er namens
      jou belt en aan tafel zit.
    </p>
    <ul class="mini-list">
      <li><b>Voorbereid.</b> We verdiepen ons in jouw markt voordat we bellen.</li>
      <li><b>Persoonlijk.</b> Geen script. Een echt gesprek, met jouw verhaal.</li>
      <li><b>Vast contact.</b> Altijd hetzelfde gezicht. Je weet wie er namens jou belt.</li>
    </ul>
  </Split>

  <!-- Partnerportaal (split, gespiegeld, screenshot geblurd) -->
  <section id="portaal">
    <Split
      src="/assets/portaal-laptop.jpeg"
      alt="Het partnerportaal op een laptop"
      ratio="4 / 3"
      tag="Logboek"
      blur
    >
      <span class="eyebrow">Altijd inzicht</span>
      <h2>Jouw eigen <span class="it">partnerportaal</span><span class="punc">.</span></h2>
      <p>
        Je hoeft nooit te vragen hoe het ervoor staat. Alles wat wij doen staat
        live in je eigen omgeving, ook als het even tegenzit.
      </p>
      <div class="portaal-grid">
        {
          portaal.map((p) => (
            <div class="portaal-item">
              <span class="k">{p.k}</span>
              <b>{p.h}</b>
              <span>{p.p}</span>
            </div>
          ))
        }
      </div>
      <a class="btn-primary" href={site.portal.url} target="_blank" rel="noopener" style="margin-top:8px">
        Bekijk het partnerportaal <Icon name="arrow" class="arrow" />
      </a>
    </Split>
  </section>

  <!-- Wat levert het op -->
  <section class="section">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow">Wat levert het op</span>
        <h2>Meer <span class="it">warme</span> gesprekken. Minder gedoe<span class="punc">.</span></h2>
      </div>
      <p class="lede">
        Samen bepalen we bij wie jij aan tafel wil zitten. Daarna gaan wij aan de
        slag, en blijven we bijsturen op wat we ophalen.
      </p>
    </div>
    <div class="reeks reeks-2 reveal-stagger">
      {
        opbrengst.map((o) => (
          <div class="reeks-item">
            <span class="k">{o.n}</span>
            <h3>{o.h}</h3>
            <p>{o.p}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-block">
    <div class="watermark" data-parallax="0.15" aria-hidden="true">LINK<span class="dot"></span></div>
    <div class="cta-inner reveal">
      <div>
        <span class="eyebrow">Klaar om te beginnen?</span>
        <h2>Wij bellen. Jij <span class="it">verkoopt</span><span class="punc">.</span></h2>
      </div>
      <div class="cta-right">
        <p class="lede">Stuur ons een berichtje of bel gewoon. We reageren snel en zonder gedoe.</p>
        <div class="btn-row">
          <a class="btn-primary" href="/contact">Plan een kennismaking <Icon name="arrow" class="arrow" /></a>
          <a class="btn-ghost" href="/aanpak">Bekijk de aanpak</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-hero {
    padding: clamp(56px, 7vw, 120px) var(--pad-x) clamp(40px, 5vw, 80px);
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(40px, 5vw, 80px);
    align-items: center;
  }
  .page-hero h1 {
    font-size: var(--t-display);
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-weight: 900;
    margin: 24px 0 0;
    max-width: 16ch;
  }
  .page-hero .lede {
    margin-top: clamp(28px, 3vw, 44px);
    font-size: var(--t-lede);
    color: var(--ink-soft);
    max-width: 56ch;
    line-height: 1.45;
  }
  .hero-actions {
    margin-top: clamp(24px, 3vw, 40px);
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .channels {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .channel {
    display: flex;
    align-items: center;
    gap: 18px;
    background: var(--paper);
    border: 1px solid var(--line-soft);
    border-radius: var(--r-card);
    padding: 20px 22px;
    transition: border-color 0.2s ease;
  }
  .channel:hover {
    border-color: var(--ink);
  }
  .ch-ic {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: color-mix(in oklab, var(--blue) 14%, var(--bg));
    color: var(--blue-deep);
    position: relative;
  }
  .ch-ic .live-dot {
    position: absolute;
    top: -3px;
    right: -3px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--blue);
    border: 2px solid var(--paper);
    animation: live-pulse 1.6s ease-out infinite;
  }
  .ch-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .ch-num {
    font-family: var(--font-mono);
    color: var(--blue-deep);
    font-size: 12px;
  }
  .ch-name {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-top: 2px;
  }
  .ch-sub {
    font-size: 13px;
    color: var(--mute);
    margin-top: 3px;
  }
  .ch-arrow {
    color: var(--mute);
    flex-shrink: 0;
    display: grid;
    transition: transform 0.25s var(--ease);
  }
  .channel:hover .ch-arrow {
    transform: translateX(4px);
    color: var(--blue-deep);
  }
  .ch-foot {
    padding: 4px;
    font-size: 13px;
    color: var(--mute);
    margin: 0;
  }

  .service-detail {
    padding: clamp(80px, 9vw, 140px) var(--pad-x);
    border-top: 1px solid var(--line);
  }
  .service-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(48px, 6vw, 120px);
    align-items: start;
  }
  .service-grid h2 {
    font-size: var(--t-h1);
    line-height: 0.94;
    letter-spacing: -0.045em;
    font-weight: 900;
    margin: 18px 0 0;
    max-width: 14ch;
  }
  .service-lede {
    margin-top: clamp(28px, 3vw, 44px);
    font-size: var(--t-lede);
    line-height: 1.5;
    max-width: 48ch;
    color: var(--ink-soft);
  }
  .spec-list {
    margin-top: clamp(28px, 3vw, 44px);
  }
  .spec {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 24px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
    align-items: baseline;
  }
  .spec:last-child {
    border-bottom: 1px solid var(--line);
  }
  .spec .k {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .spec .v {
    font-size: 17px;
    line-height: 1.45;
  }
  .spec .v :global(em) {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--blue);
  }

  /* Call-card visual */
  .call-card {
    background: var(--paper);
    border: 1px solid var(--line-soft);
    border-radius: var(--r-card);
    padding: 22px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .call-card .head {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--mute);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .rec-dot {
    width: 8px;
    height: 8px;
    background: #e54b4b;
    border-radius: 50%;
    animation: live-pulse 1.8s ease-out infinite;
  }
  .call-card .who {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .call-card .avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--blue), var(--blue-deep));
    color: var(--ink);
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 13px;
    flex-shrink: 0;
  }
  .call-card .who-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .call-card .who-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
  }
  .call-card .who-role {
    font-size: 12px;
    color: var(--mute);
  }
  .call-card .who-timer {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--blue-deep);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .waveform {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 26px;
    padding: 0 2px;
  }
  .waveform .bar {
    flex: 1;
    background: linear-gradient(to top, var(--blue), var(--blue-deep));
    border-radius: 2px;
    min-height: 4px;
    transform-origin: bottom;
    animation: wave 1.4s ease-in-out infinite;
  }
  .waveform .bar:nth-child(2n) {
    animation-delay: -0.4s;
  }
  .waveform .bar:nth-child(3n) {
    animation-delay: -0.8s;
  }
  .waveform .bar:nth-child(4n) {
    animation-delay: -1.1s;
  }
  .waveform .bar:nth-child(5n) {
    animation-delay: -0.2s;
  }
  @keyframes wave {
    0%,
    100% {
      transform: scaleY(0.35);
      opacity: 0.55;
    }
    50% {
      transform: scaleY(1);
      opacity: 1;
    }
  }
  .call-card .transcript {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 14px;
    color: var(--ink-soft);
    line-height: 1.4;
    padding-top: 10px;
    border-top: 1px dashed var(--line);
    margin: 0;
  }
  .call-card .transcript em {
    color: var(--blue-deep);
    font-style: italic;
    font-weight: 500;
  }
  .visual-cap {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 42ch;
  }
  .visual-cap b {
    font-weight: 600;
    color: var(--ink);
    margin-right: 8px;
  }

  /* Split-inhoud helpers */
  .mini-list {
    list-style: none;
    padding: 0;
    margin: 4px 0 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .mini-list li {
    position: relative;
    padding-left: 20px;
    color: var(--ink-soft);
    font-size: 16px;
    line-height: 1.5;
  }
  .mini-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 7px;
    height: 7px;
    background: var(--blue);
    border-radius: 50%;
  }
  .mini-list b {
    color: var(--ink);
    font-weight: 600;
  }
  .portaal-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-top: 4px;
  }
  .portaal-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .portaal-item .k {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue-deep);
  }
  .portaal-item b {
    font-size: 16px;
    font-weight: 700;
    color: var(--ink);
  }
  .portaal-item span:last-child {
    font-size: 14px;
    color: var(--ink-soft);
    line-height: 1.45;
  }

  .reeks-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .cta-block {
    padding: clamp(80px, 9vw, 140px) var(--pad-x);
    position: relative;
    overflow: hidden;
  }
  .cta-block .watermark {
    bottom: -60px;
  }
  .cta-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 5vw, 80px);
    align-items: end;
    position: relative;
    z-index: 2;
  }
  .cta-inner h2 {
    font-size: var(--t-display);
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-weight: 900;
    margin: 14px 0 0;
    max-width: 12ch;
  }
  .cta-right {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .cta-right .lede {
    font-size: var(--t-lede);
    color: var(--ink-soft);
    line-height: 1.45;
    margin: 0;
    max-width: 42ch;
  }
  .btn-row {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  @keyframes live-pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.6;
      transform: scale(1.2);
    }
  }

  @media (max-width: 1100px) {
    .service-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
  @media (max-width: 980px) {
    .page-hero {
      grid-template-columns: 1fr;
    }
    .cta-inner {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .portaal-grid {
      grid-template-columns: 1fr;
    }
    .spec {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
