---
import Base from '@/layouts/Base.astro';
import Figure from '@/components/Figure.astro';
import { site } from '@/lib/site';

const specs = [
  { k: 'Voor wie', v: 'B2B-bedrijven die hun salesmotor willen opzetten of versterken.' },
  { k: 'Wat je krijgt', v: 'Afspraken bij de juiste beslisser, <span class="serif">persoonlijk</span> gelegd.' },
  { k: 'Hoe', v: 'Geen script, geen call center. Eén vast gezicht in jouw verhaal.' },
  { k: 'Voorwaarden', v: 'Maandelijks opzegbaar. Geen lange contracten of hoge investering vooraf.' },
];

const portaal = [
  { k: 'Leads', h: 'Elk gesprek gelogd', p: 'Wie we spraken, wat er gezegd is en wat de volgende stap is.' },
  { k: 'Afspraken', h: 'Direct in je agenda', p: 'Met bedrijf, contactpersoon en de context van het gesprek.' },
  { k: 'Rapportage', h: 'Elke week een overzicht', p: 'Wat er is gebeurd en wat het heeft opgeleverd.' },
  { k: 'Facturen', h: 'Geen verrassingen', p: 'Je ziet precies waarvoor je betaalt.' },
];

const opbrengst = [
  { n: '01', t: 'Jouw team houdt tijd over', p: 'Het koud bellen regelen wij. Jouw team houdt zich bezig met de warme gesprekken.' },
  { n: '02', t: 'Geen risico vooraf', p: 'Geen lange contracten of hoge investering vooraf. Maandelijks opzegbaar.' },
];
---

<Base
  title="Telefonische acquisitie voor B2B-bedrijven | LINK."
  description="Persoonlijke telefonische acquisitie voor B2B-bedrijven. Wij regelen de afspraken bij de juiste beslissers, jij sluit de deals."
  path="/diensten"
>
  <!-- Hero -->
  <section class="page-hero">
    <div class="ph-copy reveal">
      <span class="eyebrow">Wat we doen</span>
      <h1 class="display">Wij bellen. Jij <span class="serif">verkoopt</span><span class="d">.</span></h1>
      <p class="sub">
        Wij bellen jouw ideale klanten zelf op, goed voorbereid en in jouw
        verhaal. Jij voert het gesprek dat ertoe doet.
      </p>
      <div class="cta-row">
        <a class="btn" href="/contact" data-magnetic>Plan een kennismaking <span class="arw">→</span></a>
        <a class="link" href="#telefonisch">Hoe het werkt</a>
      </div>
    </div>
    <div class="ph-widget reveal">
      <div class="call-card">
        <div class="cc-head"><span class="rec"></span> LIVE GESPREK</div>
        <div class="cc-who">
          <span class="cc-av">HB</span>
          <div class="cc-txt">
            <span class="cc-name">Beslisser · Logistiek</span>
            <span class="cc-role">Regio Utrecht</span>
          </div>
          <span class="cc-timer">02:14</span>
        </div>
        <div class="cc-wave" aria-hidden="true">{Array.from({ length: 20 }).map(() => <span></span>)}</div>
        <p class="cc-quote">"Klinkt interessant. <span class="serif">Stuur maar een voorstel</span>, dan plannen we een afspraak."</p>
      </div>
    </div>
  </section>

  <!-- Telefonische acquisitie -->
  <section class="band line" id="telefonisch">
    <div class="service reveal">
      <div class="service-copy">
        <span class="eyebrow">De dienst</span>
        <h2 class="headline">Telefonische <span class="serif">acquisitie</span><span class="d">.</span></h2>
        <p class="lede">
          Wij bellen jouw ideale klanten persoonlijk op, goed voorbereid en in
          jouw verhaal. Alleen wat écht een gesprek waard is, brengen we door.
        </p>
        <div class="specs">
          {
            specs.map((s) => (
              <div class="spec">
                <span class="spec-k">{s.k}</span>
                <span class="spec-v" set:html={s.v} />
              </div>
            ))
          }
        </div>
      </div>
      <p class="service-note">
        <b>Een echt gesprek.</b> Geen script dat wordt afgerateld, maar een
        voorbereid gesprek dat past bij jouw verhaal. Eén vast gezicht dat namens
        jou belt en aan tafel zit.
      </p>
    </div>
  </section>

  <!-- Wie het doet -->
  <section class="split">
    <div class="split-media reveal">
      <Figure src="/assets/hens-call-navy.jpeg" alt="Hens aan de telefoon" ratio="4 / 5" radius="20px" />
    </div>
    <div class="split-body reveal">
      <span class="eyebrow">Wie het doet</span>
      <h2 class="headline">Geen call center. <span class="serif">Eén</span> gezicht<span class="d">.</span></h2>
      <p class="lede">
        Bij LINK. spreek je geen tussenlaag. Je weet altijd precies wie er namens
        jou belt en aan tafel zit.
      </p>
      <ul class="mini-list">
        <li><b>Voorbereid.</b> We verdiepen ons in jouw markt voordat we bellen.</li>
        <li><b>Persoonlijk.</b> Geen script. Een echt gesprek, met jouw verhaal.</li>
        <li><b>Vast contact.</b> Altijd hetzelfde gezicht.</li>
      </ul>
    </div>
  </section>

  <!-- Partnerportaal -->
  <section class="split reverse" id="portaal">
    <div class="split-body reveal">
      <span class="eyebrow">Altijd inzicht</span>
      <h2 class="headline">Jouw eigen <span class="serif">partnerportaal</span><span class="d">.</span></h2>
      <p class="lede">
        Je hoeft nooit te vragen hoe het ervoor staat. Alles wat wij doen staat
        live in je eigen omgeving, ook als het even tegenzit.
      </p>
      <div class="portaal-grid">
        {
          portaal.map((p) => (
            <div class="portaal-item">
              <span class="pi-k">{p.k}</span>
              <b>{p.h}</b>
              <span>{p.p}</span>
            </div>
          ))
        }
      </div>
      <a class="link" href={site.portal.url} target="_blank" rel="noopener">Bekijk het partnerportaal →</a>
    </div>
    <div class="split-media reveal">
      <Figure src="/assets/portaal-laptop.jpeg" alt="Het partnerportaal op een laptop" ratio="4 / 3" radius="20px" blur />
    </div>
  </section>

  <!-- Wat levert het op -->
  <section class="band line">
    <div class="head reveal">
      <div>
        <span class="eyebrow">Wat levert het op</span>
        <h2 class="headline">Meer <span class="serif">warme</span> gesprekken<span class="d">.</span></h2>
      </div>
      <p class="lede">
        Samen bepalen we bij wie jij aan tafel wil zitten. Daarna gaan wij aan de
        slag, en blijven we bijsturen op wat we ophalen.
      </p>
    </div>
    <div class="cols two reveal">
      {
        opbrengst.map((o) => (
          <div class="col">
            <span class="col-n">{o.n}</span>
            <h3>{o.t}</h3>
            <p>{o.p}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="band cta">
    <span class="eyebrow">Klaar om te beginnen?</span>
    <h2 class="display">Wij bellen. Jij <span class="serif">verkoopt</span><span class="d">.</span></h2>
    <p class="lede">Stuur ons een berichtje of bel gewoon. We reageren snel en zonder gedoe.</p>
    <div class="cta-row">
      <a class="btn" href="/contact" data-magnetic>Plan een kennismaking <span class="arw">→</span></a>
      <a class="link" href="/aanpak">Bekijk de aanpak</a>
    </div>
  </section>
</Base>

<style>
  .page-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(40px, 5vw, 80px);
    align-items: center;
    padding: clamp(48px, 7vw, 110px) var(--gutter) clamp(48px, 6vw, 96px);
  }
  .ph-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .cta-row {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }

  /* Call-card */
  .call-card {
    background: var(--paper);
    border: 1px solid var(--line-soft);
    border-radius: 20px;
    padding: 22px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .cc-head {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--mute);
  }
  .rec {
    width: 8px;
    height: 8px;
    background: #e54b4b;
    border-radius: 50%;
    animation: cpulse 1.8s ease-out infinite;
  }
  .cc-who {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .cc-av {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--blue), var(--blue-deep));
    color: var(--ink);
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 13px;
  }
  .cc-txt {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .cc-name {
    font-size: 14px;
    font-weight: 600;
  }
  .cc-role {
    font-size: 12px;
    color: var(--mute);
  }
  .cc-timer {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--blue-deep);
    font-weight: 600;
  }
  .cc-wave {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 30px;
  }
  .cc-wave span {
    flex: 1;
    background: linear-gradient(to top, var(--blue), var(--blue-deep));
    border-radius: 2px;
    min-height: 4px;
    transform-origin: bottom;
    animation: cwave 1.4s ease-in-out infinite;
  }
  .cc-wave span:nth-child(2n) { animation-delay: -0.4s; }
  .cc-wave span:nth-child(3n) { animation-delay: -0.8s; }
  .cc-wave span:nth-child(4n) { animation-delay: -1.1s; }
  .cc-wave span:nth-child(5n) { animation-delay: -0.2s; }
  @keyframes cwave { 0%,100% { transform: scaleY(0.35); opacity: 0.55; } 50% { transform: scaleY(1); opacity: 1; } }
  @keyframes cpulse { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }
  .cc-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 14px;
    color: var(--ink-soft);
    line-height: 1.4;
    padding-top: 10px;
    border-top: 1px dashed var(--line);
    margin: 0;
  }
  .cc-quote .serif { color: var(--blue-deep); }

  /* Service */
  .service {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(40px, 6vw, 100px);
    align-items: start;
  }
  .service-copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .specs {
    margin-top: 8px;
  }
  .spec {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 24px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
    align-items: baseline;
  }
  .spec:last-child {
    border-bottom: 1px solid var(--line);
  }
  .spec-k {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .spec-v {
    font-size: 17px;
    line-height: 1.45;
  }
  .service-note {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(20px, 1.8vw, 26px);
    line-height: 1.4;
    color: var(--ink);
    border-left: 2px solid var(--blue);
    padding-left: 22px;
    margin: 0;
    position: sticky;
    top: 110px;
  }
  .service-note b {
    font-family: var(--font-sans);
    font-style: normal;
    font-weight: 700;
    display: block;
    margin-bottom: 6px;
  }

  .mini-list {
    list-style: none;
    padding: 0;
    margin: 4px 0 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .mini-list li {
    position: relative;
    padding-left: 20px;
    color: var(--ink-soft);
    font-size: 16px;
    line-height: 1.5;
  }
  .mini-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 7px;
    height: 7px;
    background: var(--blue);
    border-radius: 50%;
  }
  .mini-list b {
    color: var(--ink);
    font-weight: 600;
  }
  .portaal-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-top: 4px;
  }
  .portaal-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .pi-k {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue-deep);
  }
  .portaal-item b {
    font-size: 16px;
    font-weight: 700;
  }
  .portaal-item span:last-child {
    font-size: 14px;
    color: var(--ink-soft);
    line-height: 1.45;
  }

  .cta {
    display: flex;
    flex-direction: column;
    gap: 22px;
    align-items: flex-start;
  }

  @media (max-width: 1100px) {
    .service {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .service-note {
      position: static;
    }
  }
  @media (max-width: 900px) {
    .page-hero {
      grid-template-columns: 1fr;
    }
    .portaal-grid {
      grid-template-columns: 1fr;
    }
    .spec {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
