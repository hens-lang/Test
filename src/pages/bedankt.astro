---
import Base from '@/layouts/Base.astro';
import { site } from '@/lib/site';
---

<Base
  title="Bedankt | LINK."
  description="Bedankt voor je bericht. We nemen binnen 24 uur persoonlijk contact met je op."
  path="/bedankt"
>
  <section class="thanks">
    <div class="thanks-in reveal">
      <div class="thanks-ic">
        <svg viewBox="0 0 24 24" width="30" height="30" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <span class="eyebrow">Ontvangen</span>
      <h1 class="display">Bedankt. We gaan voor je <span class="serif">rekenen</span><span class="d">.</span></h1>
      <p class="lede">
        We maken een berekening op maat met jouw cijfers en nemen binnen 24 uur
        persoonlijk contact met je op. Meestal sneller.
      </p>
      <div class="thanks-row">
        <a class="btn" href="/" data-magnetic>Terug naar home <span class="arw">→</span></a>
        <a class="link" href={`tel:${site.contact.phoneHref}`}>Of bel {site.contact.phoneDisplay}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .thanks {
    padding: clamp(96px, 13vw, 200px) var(--gutter);
    display: grid;
    place-items: center;
    text-align: center;
    min-height: 60vh;
  }
  .thanks-in {
    max-width: 46ch;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }
  .thanks-ic {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #e2f3e9;
    color: #1f8a5b;
    display: grid;
    place-items: center;
    margin-bottom: 6px;
  }
  .thanks .display {
    max-width: none;
  }
  .thanks-row {
    display: flex;
    align-items: center;
    gap: 26px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 12px;
  }
</style>
