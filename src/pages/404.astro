---
import Base from '@/layouts/Base.astro';
---

<Base
  title="Pagina niet gevonden | LINK."
  description="Deze pagina bestaat niet (meer)."
  path="/404"
>
  <section class="nf">
    <div class="nf-in reveal">
      <span class="nf-code">404<span class="d">.</span></span>
      <h1 class="headline">Deze pagina is er niet<span class="d">.</span></h1>
      <p class="lede">Misschien is de link verouderd. Ga terug naar de start, of neem gewoon even contact op.</p>
      <div class="nf-row">
        <a class="btn" href="/" data-magnetic>Naar home <span class="arw">→</span></a>
        <a class="link" href="/contact">Contact</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding: clamp(96px, 13vw, 200px) var(--gutter);
    display: grid;
    place-items: center;
    text-align: center;
    min-height: 60vh;
  }
  .nf-in {
    max-width: 42ch;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .nf-code {
    font-family: var(--font-mono);
    font-size: clamp(56px, 10vw, 120px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .nf-row {
    display: flex;
    align-items: center;
    gap: 26px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 12px;
  }
</style>
