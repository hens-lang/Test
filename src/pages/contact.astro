---
import Base from '@/layouts/Base.astro';
import Chapter from '@/components/Chapter.astro';
import Duotone from '@/components/Duotone.astro';
import TariefCalculator from '@/components/widgets/TariefCalculator.astro';

const index = [
  { n: '01', label: 'Koffie' },
  { n: '02', label: 'Tarief' },
  { n: '03', label: 'Vragen' },
];

const faq = [
  { q: 'Met wat voor <em>bedrijven</em> werken jullie?', a: 'Wij werken voor B2B-bedrijven die hun salesmotor willen opzetten of versterken. Of het nu een groothandel, dienstverlener of softwarebedrijf is, als jouw klant een ander bedrijf is, kunnen wij meestal helpen. Niet zeker of we passen? Bel ons gerust.' },
  { q: 'Hoe lang duurt het voor we resultaat zien?', a: 'Eerlijk: de eerste weken zijn vooral voorbereiden, doelgroep scherpstellen, prospectlijst bouwen, jouw verhaal echt begrijpen. Vanaf maand twee verwacht je de eerste afspraken te zien. Maar we beloven niets dat we niet kunnen waarmaken.' },
  { q: 'Werken jullie met <em>vaste</em> contracten?', a: 'Nee. Wij werken maandelijks opzegbaar. Wij verdienen onze plek elke maand opnieuw, dat houdt ons scherp, en geeft jou de vrijheid om te stoppen als het niet meer klopt.' },
  { q: 'Wat als jullie denken dat het niet gaat werken?', a: 'Dan zeggen we dat. Liever een eerlijk nee vooraf dan een moeizame samenwerking achteraf. We gaan geen samenwerking aan als we er niet achter staan, dat heeft niemand iets aan.' },
  { q: 'Hoe zit het met <em>rapportage</em>?', a: 'Wekelijks. Heldere rapportages die je écht inzicht geven in wat we hebben gedaan, wat het opleverde en wat beter kan. Als iets niet loopt zoals verwacht, hoor je dat van ons zonder dat je ernaar hoeft te vragen.' },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q.replace(/<[^>]+>/g, ''),
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
};

const tracker = [
  { state: 'done', title: 'Bericht ontvangen', sub: 'We krijgen direct een melding op de telefoon.', time: '+ 0 min' },
  { state: 'done', title: 'Persoonlijke reactie van Hens', sub: 'Persoonlijk antwoord, geen auto-reply. Meestal binnen 30 minuten.', time: '+ 30 min' },
  { state: 'now', title: 'Korte kennismaking inplannen', sub: '15-20 minuten via Teams of bij ons op kantoor. Kijken of het klopt.', time: 'Vandaag' },
  { state: '', title: 'Voorstel op maat', sub: 'Als het past: doelgroep, aanpak, tarief. Geen onleesbare offertes.', time: '+ 1 week' },
  { state: '', title: 'Eerste afspraken voor jou', sub: 'Vanaf de 2e week bellen zie je de eerste gesprekken in je agenda.', time: '+ 2 weken' },
];
---

<Base
  title="Contact | Plan een kennismaking met LINK."
  description="Even kennismaken bij een kop koffie? Bel (0172) 27 10 08 of mail info@linkgrp.nl. We reageren meestal binnen 30 minuten. Gevestigd in Alphen aan den Rijn."
  path="/contact"
  jsonLd={faqJsonLd}
  index={index}
>
  <!-- 01 — Hero + tracker -->
  <section class="page-hero" id="h01">
    <div class="ph-copy reveal">
      <Chapter n="01" label="Contact" />
      <h1 class="h-giant">Een kop <em>koffie</em> met je<span class="dot">.</span></h1>
      <p class="lede-xl">
        Gewoon kennismaken bij een kop koffie. Past het, dan plannen we een
        vervolg. Past het niet, dan zeggen we dat ook eerlijk.
      </p>
    </div>

    <aside class="tracker reveal" aria-label="Wat gebeurt er na je bericht">
      <div class="tr-head">
        <div>
          <span class="tr-eyebrow">Na je bericht</span>
          <span class="tr-name">Zo gaan we te <em>werk</em></span>
        </div>
        <span class="tr-id">#LINK-2206</span>
      </div>
      <ul class="tr-steps">
        {
          tracker.map((t) => (
            <li class:list={['tr-step', t.state]}>
              <span class="tr-marker">
                {t.state === 'done' ? (
                  <svg viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                ) : t.state === 'now' ? (
                  <svg viewBox="0 0 24 24" fill="none"><path d="M12 8v4l3 3M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                ) : (
                  <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/></svg>
                )}
              </span>
              <div class="tr-info">
                <span class="tr-t">{t.title}</span>
                <span class="tr-s">{t.sub}</span>
              </div>
              <span class="tr-time">{t.time}</span>
            </li>
          ))
        }
      </ul>
      <div class="tr-foot">
        <span class="tr-av">HB</span>
        <div class="tr-promise">
          <b>Reageert meestal <em>binnen 30 minuten</em></b>
          <span>Hens · zonder gedoe</span>
        </div>
      </div>
    </aside>
  </section>

  <!-- 02 — Tarief -->
  <section class="contact-grid" id="h02">
    <div class="cg-intro reveal">
      <Chapter n="02" label="Tarief op maat" />
      <h2 class="h-section">Wat kost het?<br />Dat <em>rekenen</em> we uit<span class="dot">.</span></h2>
      <p class="lede-xl">
        Vier korte vragen over jouw cijfers. Daarna maken we persoonlijk een
        berekening op maat. Je verplicht je tot niets.
      </p>
      <div class="cg-photo">
        <Duotone src="/assets/hens-coffee.jpeg" alt="Hens bij een kop koffie" ratio="4 / 3" caption="EVEN KENNISMAKEN" position="center 20%" />
      </div>
    </div>
    <TariefCalculator />
  </section>

  <!-- 03 — FAQ -->
  <section class="mag-sec" id="h03">
    <div class="split-head reveal">
      <div>
        <Chapter n="03" label="Vragen vooraf" />
        <h2 class="h-section">Wat je nog wilde <em>weten</em><span class="dot">.</span></h2>
      </div>
      <p class="lede-xl">Een paar vragen die we vaak krijgen. Mist er iets? Stuur het ons gerust.</p>
    </div>
    <div class="faq-list reveal">
      {
        faq.map((f) => (
          <details class="faq-item">
            <summary>
              <span class="q" set:html={f.q} />
              <span class="ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" width="14" height="14"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              </span>
            </summary>
            <p class="answer">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .page-hero {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(40px, 5vw, 80px);
    align-items: center;
    padding: clamp(40px, 6vw, 96px) var(--rail) clamp(48px, 6vw, 96px);
  }
  .ph-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* Tracker */
  .tracker {
    background: var(--paper);
    border: 1px solid var(--line-soft);
    border-radius: var(--r-card);
    padding: 24px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    gap: 20px;
    overflow: hidden;
  }
  .tr-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .tr-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mute);
    margin-bottom: 2px;
  }
  .tr-name {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .tr-name em {
    color: var(--blue);
  }
  .tr-id {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--mute);
    background: var(--bg);
    padding: 4px 8px;
    border-radius: 6px;
    border: 1px solid var(--line-soft);
  }
  .tr-steps {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tr-step {
    display: grid;
    grid-template-columns: 30px 1fr auto;
    gap: 14px;
    align-items: start;
    padding: 12px 0;
    position: relative;
  }
  .tr-step + .tr-step::before {
    content: '';
    position: absolute;
    top: -8px;
    bottom: calc(100% - 16px);
    left: 14px;
    width: 2px;
    background: var(--line);
  }
  .tr-step.done + .tr-step::before {
    background: var(--blue);
  }
  .tr-marker {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--line);
    display: grid;
    place-items: center;
    color: var(--mute);
    position: relative;
    z-index: 1;
  }
  .tr-marker svg {
    width: 14px;
    height: 14px;
  }
  .tr-step.done .tr-marker {
    background: var(--blue);
    border-color: var(--blue);
    color: var(--ink);
  }
  .tr-step.now .tr-marker {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .tr-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding-top: 2px;
  }
  .tr-t {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .tr-step:not(.done):not(.now) .tr-t {
    color: var(--mute);
  }
  .tr-s {
    font-size: 12px;
    color: var(--mute);
    line-height: 1.45;
    max-width: 38ch;
  }
  .tr-time {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--mute);
    padding-top: 4px;
    white-space: nowrap;
  }
  .tr-step.done .tr-time {
    color: var(--blue);
    font-weight: 700;
  }
  .tr-step.now .tr-time {
    color: var(--ink);
    font-weight: 700;
  }
  .tr-foot {
    background: var(--ink);
    color: var(--paper);
    margin: 0 -24px -24px;
    padding: 18px 24px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .tr-av {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: linear-gradient(135deg, #e8916f, #b85b36);
    color: white;
    display: grid;
    place-items: center;
    font-size: 11px;
    font-weight: 700;
  }
  .tr-promise b {
    display: block;
    font-size: 13px;
    font-weight: 700;
    color: var(--paper);
  }
  .tr-promise em {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--blue);
    font-weight: 400;
  }
  .tr-promise span {
    font-size: 11px;
    color: var(--dark-mute);
  }

  /* Contact-grid */
  .contact-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(40px, 5vw, 96px);
    align-items: start;
    padding: clamp(56px, 7vw, 120px) var(--rail);
    border-top: 1px solid var(--line);
  }
  .cg-intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: sticky;
    top: 120px;
  }
  .cg-photo {
    margin-top: 8px;
  }
  .cg-photo :global(.duo) {
    min-height: 30vh;
  }

  .split-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: end;
  }

  /* FAQ */
  .faq-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
    margin-top: clamp(32px, 4vw, 56px);
  }
  .faq-item {
    border-bottom: 1px solid var(--line);
    padding: 20px 4px;
  }
  .faq-item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
    cursor: pointer;
    font-size: clamp(20px, 1.8vw, 28px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    gap: 24px;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary .q :global(em) {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--blue-deep);
  }
  .faq-item:hover summary {
    color: var(--blue-deep);
  }
  .faq-item .ico {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
    transition: transform 0.3s var(--ease), background 0.2s, color 0.2s;
    color: var(--ink);
  }
  .faq-item[open] .ico {
    transform: rotate(45deg);
    background: var(--blue);
    border-color: var(--blue);
  }
  .faq-item .answer {
    margin: 14px 0 0;
    color: var(--ink-soft);
    font-size: 16px;
    line-height: 1.6;
    max-width: 64ch;
  }

  @media (max-width: 900px) {
    .page-hero {
      grid-template-columns: 1fr;
    }
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .cg-intro {
      position: static;
    }
    .split-head {
      grid-template-columns: 1fr;
    }
  }
</style>
