---
import Base from '@/layouts/Base.astro';
import Chapter from '@/components/Chapter.astro';
import Duotone from '@/components/Duotone.astro';
import TimelineWidget from '@/components/widgets/TimelineWidget.astro';

const index = [
  { n: '01', label: 'Ik ben Hens' },
  { n: '02', label: 'Wie ik ben' },
  { n: '03', label: 'Hoe ik werk' },
  { n: '04', label: 'Uitgangspunt' },
  { n: '05', label: 'Waarden' },
  { n: '06', label: 'Koffie' },
];

const values = [
  { n: '01', t: 'Transparantie', p: 'Je weet altijd waar je aan toe bent. Ik ben open over wat we doen, hoe het gaat en wat beter kan.', pull: 'Eerlijk, ook als het tegenzit.' },
  { n: '02', t: 'Eerlijkheid', p: 'Ik zeg wat ik denk. Ook als het niet uitkomt. Ik ga geen samenwerking aan als ik er niet achter sta.', pull: 'Recht door zee.' },
  { n: '03', t: 'Lange termijn', p: 'Ik wil meedenken, meegroeien en echt iets opbouwen. Daarom geen lange contracten, ik verdien mijn plek elke maand opnieuw.', pull: 'Jouw succes is mijn succes.' },
];
---

<Base
  title="Ons verhaal | LINK. — één gezicht, één belofte"
  description="LINK. is opgericht door Hens: één vast gezicht dat gelooft in de juiste afspraak in plaats van volume. Lees waarom wij het anders doen."
  path="/verhaal"
  index={index}
>
  <!-- 01 — Hero -->
  <section class="page-hero" id="h01">
    <div class="ph-copy reveal">
      <Chapter n="01" label="Ons verhaal" />
      <h1 class="h-giant">Ik zag dat het <em>anders</em> kon<span class="dot">.</span></h1>
      <p class="lede-xl">
        Ik ben Hens. Ik werk graag dichtbij, denk met je mee en drink het liefst
        eerst een kop koffie voordat we iets afspreken.
      </p>
    </div>
    <div class="ph-widget reveal">
      <TimelineWidget />
    </div>
  </section>

  <!-- 02 — Wie ik ben -->
  <section class="bio" id="h02">
    <div class="bio-media reveal">
      <Duotone src="/assets/hens-sun-tall.jpeg" alt="Portret van Hens" ratio="4 / 5" caption="HENS — EIGENAAR" />
    </div>
    <div class="bio-copy reveal">
      <Chapter n="02" label="Wie ik ben" />
      <h2 class="h-section">Hens<span class="dot">.</span></h2>
      <span class="role">Eigenaar · Sales &amp; outreach</span>
      <p class="lede-xl">
        Drie jaar lang heb ik dagelijks aan direct sales gedaan: mensen benaderd
        die mij niet verwachten, met een product waar zij niet op zitten te
        wachten. Je leert snel wat werkt en wat niet. Precies die ervaring zet ik
        nu in bij LINK<span class="dot">.</span>
      </p>
    </div>
  </section>

  <!-- 03 — Hoe ik werk -->
  <section class="bio reverse" id="h03">
    <div class="bio-copy reveal">
      <Chapter n="03" label="Hoe ik werk" />
      <h2 class="h-section">Zelf aan de <em>lijn</em><span class="dot">.</span></h2>
      <span class="role">Met een team dat meegroeit</span>
      <p class="lede-xl">
        Ik bel en schrijf zelf. Niet omdat het niet anders kan, maar omdat je het
        verschil hoort in een gesprek dat door iemand met het verhaal wordt
        gevoerd. Groeit een samenwerking, dan groeit het team mee. Je vaste
        aanspreekpunt blijft.
      </p>
    </div>
    <div class="bio-media reveal">
      <Duotone src="/assets/hens-notebook-laughing.jpeg" alt="Hens lachend met notitieboek" ratio="4 / 5" caption="ZELF AAN DE LIJN" />
    </div>
  </section>

  <!-- 04 — Manifest -->
  <section class="statement-sec on-dark" id="h04">
    <Chapter n="04" label="Hoe LINK. ontstond" />
    <h2><em>Kwaliteit</em> boven kwantiteit<span class="dot">.</span></h2>
    <p class="lede-xl" style="margin-top: 28px; max-width: 54ch;">
      Ik stuur niet op aantallen, maar op afspraken die converteren naar klanten.
      Liever één gesprek met de juiste beslisser dan tien afspraken die nergens
      toe leiden. Zodat jij écht een kans hebt om te verkopen.
    </p>
  </section>

  <!-- 05 — Waarden -->
  <section class="mag-sec" id="h05">
    <div class="split-head reveal">
      <div>
        <Chapter n="05" label="Waarom LINK." />
        <h2 class="h-section">Drie dingen die <em>altijd</em> gelden<span class="dot">.</span></h2>
      </div>
      <p class="lede-xl">
        Een goede samenwerking begint met vertrouwen, openheid en transparantie,
        van beide kanten. Als die basis er is, werkt de rest vanzelf.
      </p>
    </div>
    <div class="values reveal-stagger">
      {
        values.map((v) => (
          <article class="value">
            <span class="value-n">{v.n}</span>
            <h3>{v.t}</h3>
            <p>{v.p}</p>
            <span class="value-pull">{v.pull}</span>
          </article>
        ))
      }
    </div>
  </section>

  <!-- 06 — CTA -->
  <section class="mag-sec cta-sec" id="h06">
    <Chapter n="06" label="Ons uitgangspunt" />
    <h2 class="h-display">Jouw succes is <em>mijn</em> succes<span class="dot">.</span></h2>
    <p class="lede-xl">
      Ik groei mee in jouw organisatie. Geen marketingzin, maar hoe ik elke
      samenwerking aanpak. Ik verdien mijn plek pas als jij resultaat ziet.
    </p>
    <div class="hero-cta">
      <a class="ebtn" href="/contact">Drink een koffie met me <span class="arw">→</span></a>
      <a class="ebtn ghost" href="/aanpak">Hoe ik werk</a>
    </div>
  </section>
</Base>

<style>
  .page-hero {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(40px, 5vw, 80px);
    align-items: center;
    padding: clamp(40px, 6vw, 96px) var(--rail) clamp(48px, 6vw, 96px);
  }
  .ph-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .bio {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(40px, 5vw, 96px);
    align-items: center;
    padding: clamp(56px, 7vw, 120px) var(--rail);
    border-top: 1px solid var(--line);
  }
  .bio.reverse {
    grid-template-columns: 1.1fr 0.9fr;
  }
  .bio.reverse .bio-media {
    order: 2;
  }
  .bio-media :global(.duo) {
    min-height: 56vh;
  }
  .bio-copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .bio-copy .role {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .split-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: end;
  }
  .values {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(28px, 3vw, 56px);
    margin-top: clamp(40px, 5vw, 72px);
  }
  .value {
    border-top: 2px solid var(--ink);
    padding-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .value-n {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--blue-deep);
  }
  .value h3 {
    font-size: clamp(26px, 2.6vw, 40px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
    margin: 0;
  }
  .value p {
    color: var(--ink-soft);
    font-size: 16px;
    line-height: 1.55;
    margin: 0;
    max-width: 38ch;
  }
  .value-pull {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 18px;
    color: var(--mute);
    margin-top: 4px;
  }
  .cta-sec {
    display: flex;
    flex-direction: column;
    gap: 22px;
    align-items: flex-start;
  }
  .hero-cta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  @media (max-width: 900px) {
    .page-hero {
      grid-template-columns: 1fr;
    }
    .bio,
    .bio.reverse {
      grid-template-columns: 1fr;
    }
    .bio.reverse .bio-media {
      order: 0;
    }
    .split-head {
      grid-template-columns: 1fr;
    }
    .values {
      grid-template-columns: 1fr;
    }
  }
</style>
