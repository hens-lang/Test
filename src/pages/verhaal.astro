---
import Base from '@/layouts/Base.astro';
import Figure from '@/components/Figure.astro';
import TimelineWidget from '@/components/widgets/TimelineWidget.astro';

const values = [
  { n: '01', t: 'Transparantie', p: 'Je weet altijd waar je aan toe bent. Ik ben open over wat we doen, hoe het gaat en wat beter kan.', pull: 'Eerlijk, ook als het tegenzit.' },
  { n: '02', t: 'Eerlijkheid', p: 'Ik zeg wat ik denk. Ook als het niet uitkomt. Ik ga geen samenwerking aan als ik er niet achter sta.', pull: 'Recht door zee.' },
  { n: '03', t: 'Lange termijn', p: 'Ik wil meedenken, meegroeien en echt iets opbouwen. Daarom geen lange contracten, ik verdien mijn plek elke maand opnieuw.', pull: 'Jouw succes is mijn succes.' },
];
---

<Base
  title="Ons verhaal | LINK. — één gezicht, één belofte"
  description="LINK. is opgericht door Hens: één vast gezicht dat gelooft in de juiste afspraak in plaats van volume. Lees waarom wij het anders doen."
  path="/verhaal"
>
  <!-- Hero -->
  <section class="page-hero">
    <div class="ph-copy reveal">
      <span class="eyebrow">Ons verhaal</span>
      <h1 class="display">Ik zag dat het <span class="serif">anders</span> kon<span class="d">.</span></h1>
      <p class="sub">
        Ik ben Hens. Ik werk graag dichtbij, denk met je mee en drink het liefst
        eerst een kop koffie voordat we iets afspreken.
      </p>
    </div>
    <div class="ph-widget reveal"><TimelineWidget /></div>
  </section>

  <!-- Wie ik ben -->
  <section class="split">
    <div class="split-media reveal">
      <Figure src="/assets/hens-sun-tall.jpeg" alt="Portret van Hens" ratio="4 / 5" radius="20px" />
    </div>
    <div class="split-body reveal">
      <span class="eyebrow">Wie ik ben</span>
      <h2 class="headline">Hens<span class="d">.</span></h2>
      <span class="role">Eigenaar · Sales &amp; outreach</span>
      <p class="lede">
        Drie jaar lang heb ik dagelijks aan direct sales gedaan: mensen benaderd
        die mij niet verwachten, met een product waar zij niet op zitten te
        wachten. Je leert snel wat werkt en wat niet. Precies die ervaring zet ik
        nu in bij LINK<span class="d">.</span>
      </p>
    </div>
  </section>

  <!-- Hoe ik werk -->
  <section class="split reverse">
    <div class="split-body reveal">
      <span class="eyebrow">Hoe ik werk</span>
      <h2 class="headline">Zelf aan de <span class="serif">lijn</span><span class="d">.</span></h2>
      <span class="role">Met een team dat meegroeit</span>
      <p class="lede">
        Ik bel en schrijf zelf. Niet omdat het niet anders kan, maar omdat je het
        verschil hoort in een gesprek dat door iemand met het verhaal wordt
        gevoerd. Groeit een samenwerking, dan groeit het team mee. Je vaste
        aanspreekpunt blijft.
      </p>
    </div>
    <div class="split-media reveal">
      <Figure src="/assets/hens-notebook-laughing.jpeg" alt="Hens lachend met notitieboek" ratio="4 / 5" radius="20px" />
    </div>
  </section>

  <!-- Manifest -->
  <section class="statement dark on-dark reveal">
    <span class="eyebrow">Hoe LINK. ontstond</span>
    <p><span class="serif">Kwaliteit</span> boven kwantiteit<span class="d">.</span></p>
    <p class="lede manifest-lede">
      Ik stuur niet op aantallen, maar op afspraken die converteren naar klanten.
      Liever één gesprek met de juiste beslisser dan tien afspraken die nergens
      toe leiden. Zodat jij écht een kans hebt om te verkopen.
    </p>
  </section>

  <!-- Waarden -->
  <section class="band">
    <div class="head reveal">
      <div>
        <span class="eyebrow">Waarom LINK.</span>
        <h2 class="headline">Drie dingen die <span class="serif">altijd</span> gelden<span class="d">.</span></h2>
      </div>
      <p class="lede">
        Een goede samenwerking begint met vertrouwen, openheid en transparantie,
        van beide kanten. Als die basis er is, werkt de rest vanzelf.
      </p>
    </div>
    <div class="cols reveal">
      {
        values.map((v) => (
          <div class="col">
            <span class="col-n">{v.n}</span>
            <h3>{v.t}</h3>
            <p>{v.p}</p>
            <span class="val-pull">{v.pull}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="band line cta">
    <span class="eyebrow">Ons uitgangspunt</span>
    <h2 class="display">Jouw succes is <span class="serif">mijn</span> succes<span class="d">.</span></h2>
    <p class="lede">
      Ik groei mee in jouw organisatie. Geen marketingzin, maar hoe ik elke
      samenwerking aanpak. Ik verdien mijn plek pas als jij resultaat ziet.
    </p>
    <div class="cta-row">
      <a class="btn" href="/contact" data-magnetic>Drink een koffie met me <span class="arw">→</span></a>
      <a class="link" href="/aanpak">Hoe ik werk</a>
    </div>
  </section>
</Base>

<style>
  .page-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(40px, 5vw, 80px);
    align-items: center;
    padding: clamp(48px, 7vw, 110px) var(--gutter) clamp(48px, 6vw, 96px);
  }
  .ph-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .role {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .manifest-lede {
    margin-top: 26px;
    max-width: 54ch;
    color: var(--dark-text);
  }
  .val-pull {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 18px;
    color: var(--mute);
    margin-top: 4px;
  }
  .cta {
    display: flex;
    flex-direction: column;
    gap: 22px;
    align-items: flex-start;
  }
  .cta-row {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }
  @media (max-width: 900px) {
    .page-hero {
      grid-template-columns: 1fr;
    }
  }
</style>
