# linkgrp.nl: nette URL's zonder .html
# /contact laadt contact.html; wie /contact.html opvraagt, gaat permanent (301)
# naar /contact. Canonicals en sitemap.xml gebruiken dezelfde nette URL's.

Options -MultiViews -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Altijd via https://www.linkgrp.nl (zelfde adres als de canonicals).
  #    Werkt ook achter een proxy/CDN die zelf https afhandelt.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?linkgrp\.nl$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://www.linkgrp.nl%{REQUEST_URI} [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^linkgrp\.nl$ [NC]
  RewriteRule ^ https://www.linkgrp.nl%{REQUEST_URI} [R=301,L,NE]

  # Bronbestanden en tooling niet openbaar
  RewriteRule ^(?:content|tools)(?:/|$) - [R=404,L]
  RewriteRule ^README\.md$ - [R=404,L]

  # 2. Oude adressen naar de huidige pagina
  RewriteRule ^ons-verhaal(?:\.html)?$ /over-link [R=301,L]
  RewriteRule ^waarom-link(?:\.html)?$ /over-link#waarom [R=301,L,NE]

  # 3. /index.html en /index naar /
  RewriteCond %{THE_REQUEST} \s/+index(?:\.html)?[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # 4. /pagina.html naar /pagina (alleen bij een echte aanvraag, geen lus)
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # 5. /pagina/ (met slash) naar /pagina
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # 6. /pagina laadt intern pagina.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^.]+)$ $1.html [L]
</IfModule>

# Caching: HTML altijd vers, assets lang
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
