# Database
DATABASE_URL="postgresql://link:link@localhost:5432/link_outreach"

# Sessies (min. 32 tekens)
SESSION_SECRET="verander-dit-naar-een-lange-willekeurige-string"

# AES-256-GCM sleutel voor SMTP/IMAP-wachtwoorden (32 bytes hex = 64 tekens)
# Genereer met: openssl rand -hex 32
ENCRYPTION_KEY=""

# Verzendmodus: demo = mails worden gelogd maar niet verstuurd (default), live = echt versturen
SEND_MODE="demo"

# Optioneel: Anthropic API voor personalisatie, reply-classificatie en conceptantwoorden.
# Zonder key valt alles terug op regelgebaseerde alternatieven.
ANTHROPIC_API_KEY=""

# Basis-URL van de app (voor unsubscribe-links en tracking)
APP_URL="http://localhost:3000"

# SMTP voor systeemnotificaties (weekrapporten, alerts) — optioneel in demo
NOTIFY_SMTP_HOST=""
NOTIFY_SMTP_PORT="587"
NOTIFY_SMTP_USER=""
NOTIFY_SMTP_PASS=""
NOTIFY_FROM="platform@linkgrp.nl"
