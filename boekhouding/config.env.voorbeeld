# Kopieer dit bestand naar "config.env" en vul in wat je gebruikt.
# config.env bevat wachtwoorden en sleutels: deel het nooit en zet het niet in git.

# ---- Inloggen op de app (aanbevolen) ----
APP_WACHTWOORD=
APP_GEHEIM=kies-hier-een-lange-willekeurige-tekst

# ---- Facturen lezen met AI (Claude) ----
# Sleutel aanmaken op https://console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# ---- Factuurmailbox (inkomende facturen) ----
# Bijvoorbeeld een apart adres facturen@jullie-domein.nl
# Gmail: imap.gmail.com + app-wachtwoord | Outlook/Microsoft 365: outlook.office365.com
IMAP_HOST=
IMAP_GEBRUIKER=
IMAP_WACHTWOORD=
IMAP_MAP=INBOX
# optioneel: verplaats verwerkte mails naar deze map
IMAP_VERWERKT_MAP=

# ---- Uitgaande e-mail (verkoopfacturen, herinneringen, dagelijkse samenvatting) ----
SMTP_HOST=
SMTP_POORT=587
SMTP_GEBRUIKER=
SMTP_WACHTWOORD=
SMTP_AFZENDER=
# waar de dagelijkse samenvatting heen gaat (standaard: e-mail uit Instellingen)
MELDING_EMAIL=

# ---- ABN AMRO via Ponto ----
# Account: https://myponto.com -> Integrations -> nieuwe integratie (eigen organisatie)
# Download het certificaat + de private key en zet ze in deze map.
PONTO_CLIENT_ID=
PONTO_CLIENT_SECRET=
PONTO_CERT=certificate.pem
PONTO_KEY=private_key.pem
PONTO_KEY_WACHTWOORD=
# sandbox om te testen, live voor echt
PONTO_OMGEVING=live
